<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base badge shape -->
    <Style x:Key="StatusBadgeBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource PillRadius}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatusBadgeSuccess" TargetType="Border" BasedOn="{StaticResource StatusBadgeBase}">
        <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" />
    </Style>

    <Style x:Key="StatusBadgeWarning" TargetType="Border" BasedOn="{StaticResource StatusBadgeBase}">
        <Setter Property="Background" Value="{StaticResource WarningSurfaceBrush}" />
    </Style>

    <Style x:Key="StatusBadgeDanger" TargetType="Border" BasedOn="{StaticResource StatusBadgeBase}">
        <Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}" />
    </Style>

    <Style x:Key="StatusBadgeInfo" TargetType="Border" BasedOn="{StaticResource StatusBadgeBase}">
        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
    </Style>

    <Style x:Key="StatusBadgeNeutral" TargetType="Border" BasedOn="{StaticResource StatusBadgeBase}">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
    </Style>

</ResourceDictionary>
