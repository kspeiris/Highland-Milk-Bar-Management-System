<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Colour tokens (single source of truth for the whole app).
         These are application colours, not an official Highland brand spec.
         ============================================================ -->

    <!-- Brand -->
    <Color x:Key="PrimaryColor">#145DA0</Color>
    <Color x:Key="PrimaryDarkColor">#12304A</Color>
    <Color x:Key="PrimaryLightColor">#EAF3FB</Color>
    <Color x:Key="AccentColor">#32A6C7</Color>

    <!-- Surfaces -->
    <Color x:Key="BackgroundColor">#F4F7FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#172B3A</Color>
    <Color x:Key="TextSecondaryColor">#647789</Color>

    <!-- Status -->
    <Color x:Key="SuccessColor">#23976A</Color>
    <Color x:Key="WarningColor">#E5A132</Color>
    <Color x:Key="DangerColor">#D94B4B</Color>

    <!-- Lines -->
    <Color x:Key="BorderColor">#E3EAF1</Color>

    <!-- Derived / interaction -->
    <Color x:Key="PrimaryHoverColor">#11528C</Color>
    <Color x:Key="PrimaryPressedColor">#0E4677</Color>
    <Color x:Key="SuccessHoverColor">#1E8059</Color>
    <Color x:Key="DangerHoverColor">#C23F3F</Color>
    <Color x:Key="FocusColor">#32A6C7</Color>

    <!-- Sidebar -->
    <Color x:Key="SidebarColor">#12304A</Color>
    <Color x:Key="SidebarHoverColor">#1B3A52</Color>
    <Color x:Key="SidebarSelectedColor">#1C4C70</Color>
    <Color x:Key="SidebarTextColor">#C7D6E4</Color>

    <!-- ============================================================
         Brushes
         ============================================================ -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="{StaticResource SuccessHoverColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />

    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource SidebarSelectedColor}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}" />

    <!-- ============================================================
         Legacy aliases (kept so existing views continue to compile)
         ============================================================ -->
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource WarningColor}" />

</ResourceDictionary>