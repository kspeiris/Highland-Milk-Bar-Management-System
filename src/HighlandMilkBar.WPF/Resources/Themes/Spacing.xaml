<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spacing scale: 4, 8, 12, 16, 20, 24, 32, 40 -->
    <Thickness x:Key="Spacing4">4</Thickness>
    <Thickness x:Key="Spacing8">8</Thickness>
    <Thickness x:Key="Spacing12">12</Thickness>
    <Thickness x:Key="Spacing16">16</Thickness>
    <Thickness x:Key="Spacing20">20</Thickness>
    <Thickness x:Key="Spacing24">24</Thickness>
    <Thickness x:Key="Spacing32">32</Thickness>
    <Thickness x:Key="Spacing40">40</Thickness>

    <!-- Corner radii -->
    <CornerRadius x:Key="ControlRadius">9</CornerRadius>
    <CornerRadius x:Key="CardRadius">14</CornerRadius>
    <CornerRadius x:Key="PillRadius">18</CornerRadius>

    <!-- Standard paddings -->
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="ControlPadding">12,8</Thickness>
    <Thickness x:Key="InputPadding">11,9</Thickness>
    <Thickness x:Key="PageMargin">28,22,28,26</Thickness>

</ResourceDictionary>