<Window x:Class="HighlandMilkBar.WPF.Views.ExpenseDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Expense details" Width="520" Height="560" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="DescriptionText" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock x:Name="AmountText" FontSize="16" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource FlatCard}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DETAILS" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                    <TextBlock x:Name="DateText" Margin="0,2" />
                    <TextBlock x:Name="CategoryText" Margin="0,2" />
                    <TextBlock x:Name="MethodText" Margin="0,2" />
                    <TextBlock x:Name="ReferenceText" Margin="0,2" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="RECORD" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                    <TextBlock x:Name="CreatedText" Margin="0,2" />
                    <TextBlock x:Name="CashText" Margin="0,2" />
                    <TextBlock x:Name="NotesText" Margin="0,2" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Button Grid.Row="2" Content="Close" Style="{StaticResource OutlineButton}" MinWidth="100"
                HorizontalAlignment="Right" Margin="0,16,0,0" Click="Close_Click" />
    </Grid>
</Window>