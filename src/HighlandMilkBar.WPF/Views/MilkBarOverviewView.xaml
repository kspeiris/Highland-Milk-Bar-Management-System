<UserControl x:Class="HighlandMilkBar.WPF.Views.MilkBarOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- KPI cards -->
            <UniformGrid Columns="3" Margin="0,0,0,6">
                <Border Margin="0,0,6,6"><controls:StatCard Title="Total Menu Items" Value="{Binding TotalMenuItems}" Glyph="▤" Caption="Prepared products on the menu" /></Border>
                <Border Margin="0,0,6,6"><controls:StatCard Title="Active Recipes" Value="{Binding ActiveRecipes}" Glyph="◍" Caption="Recipes available for sale" /></Border>
                <Border Margin="6,0,0,6"><controls:StatCard Title="Ingredients Used" Value="{Binding TotalIngredients}" Glyph="◈" Caption="Distinct recipe ingredients" /></Border>
            </UniformGrid>
            <UniformGrid Columns="3">
                <Border Margin="0,0,6,0"><controls:StatCard Title="Low Stock Ingredients" Value="{Binding LowStockIngredients}" Glyph="⚠" Caption="At or below reorder level" /></Border>
                <Border Margin="0,0,6,0"><controls:StatCard Title="Avg Recipe Cost" Value="{Binding AverageCost, StringFormat=N2}" Glyph="＄" Caption="Estimated cost per serving" /></Border>
                <Border Margin="6,0,0,0"><controls:StatCard Title="Avg Margin" Value="{Binding AverageMargin, StringFormat=N1}" Glyph="%" Caption="Estimated gross margin" /></Border>
            </UniformGrid>

            <!-- Alerts -->
            <Border Style="{StaticResource AppCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="ALERTS" Style="{StaticResource LabelText}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Alerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="9"
                                        Background="{StaticResource BackgroundBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Type}" FontWeight="SemiBold" Width="150" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <controls:EmptyState Glyph="✓" Title="No alerts" Message="All recipes are fully available and within target margins."
                                         Visibility="{Binding HasAlerts, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- Cost breakdown -->
            <Border Style="{StaticResource AppCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="INGREDIENT COST BREAKDOWN" Style="{StaticResource LabelText}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding IngredientCostBreakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Height="10" Minimum="0" Maximum="100"
                                                 Value="{Binding SharePercent}" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding TotalCost, StringFormat=LKR {0:N2}}" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <controls:EmptyState Glyph="✦" Title="No ingredient costs yet" Message="Create recipes to see where your ingredient spend goes." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>