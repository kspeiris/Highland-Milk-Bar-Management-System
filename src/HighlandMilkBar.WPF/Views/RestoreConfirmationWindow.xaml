<Window x:Class="HighlandMilkBar.WPF.Views.RestoreConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore Database" Width="560" Height="640" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Restore database" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Review the selected backup before restoring. Restoring replaces the current database."
                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="SELECTED BACKUP" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <Border Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="FileNameText" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="CreatedText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        <TextBlock x:Name="SizeText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        <TextBlock x:Name="ChecksumText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="VERIFICATION" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <Border Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="OverallText" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock x:Name="ChecksText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="WarningsHeader" Text="WARNINGS" Style="{StaticResource LabelText}" Margin="0,0,0,8" Visibility="Collapsed" />
                <Border x:Name="WarningsCard" Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,14" Visibility="Collapsed"
                        BorderBrush="{StaticResource WarningBrush}">
                    <TextBlock x:Name="WarningsText" TextWrapping="Wrap" FontSize="12" />
                </Border>

                <TextBlock x:Name="ErrorsHeader" Text="ERRORS" Style="{StaticResource LabelText}" Margin="0,0,0,8" Visibility="Collapsed" />
                <Border x:Name="ErrorsCard" Padding="12" CornerRadius="8" Margin="0,0,0,14" Background="{StaticResource DangerBrush}" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorsText" Foreground="White" TextWrapping="Wrap" FontSize="12" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource OutlineButton}" MinWidth="100" Margin="0,0,10,0" Click="Cancel_Click" />
            <Button x:Name="RestoreButton" Content="Restore Database" Style="{StaticResource DangerButton}" MinWidth="160" Click="Restore_Click" />
        </StackPanel>
    </Grid>
</Window>