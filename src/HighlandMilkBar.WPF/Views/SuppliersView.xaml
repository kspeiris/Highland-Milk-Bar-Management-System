<UserControl x:Class="HighlandMilkBar.WPF.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls"
             Loaded="SuppliersView_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Suppliers" Subtitle="Maintain the supplier directory, balances and statements.">
            <controls:PageHeader.HeaderContent>
                <Button Content="＋  Add supplier" Style="{StaticResource PrimaryButton}" MinWidth="150" Command="{Binding NewCommand}" />
            </controls:PageHeader.HeaderContent>
        </controls:PageHeader>

        <Border Grid.Row="1" Style="{StaticResource FlatCard}" Margin="0,18,0,0" Padding="14">
            <StackPanel Orientation="Horizontal">
                <Border Width="260" Margin="0,0,10,0">
                    <controls:SearchBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
                <ComboBox Style="{StaticResource AppComboBox}" MinWidth="150" Margin="0,0,10,0"
                          ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedStatus}" ToolTip="Filter by status" />
                <Button Content="Search" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="0,0,8,0" Command="{Binding SearchCommand}" />
                <Button Content="Clear" Style="{StaticResource OutlineButton}" MinWidth="80" Command="{Binding ClearCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Edit" Style="{StaticResource SecondaryButton}" MinWidth="80" Margin="0,0,8,0" Command="{Binding EditCommand}" />
                <Button Content="Details" Style="{StaticResource OutlineButton}" MinWidth="90" Margin="0,0,8,0" Command="{Binding DetailsCommand}" />
                <Button Content="Statement" Style="{StaticResource OutlineButton}" MinWidth="100" Margin="0,0,8,0" Command="{Binding StatementCommand}" />
                <Button Content="Activate / Deactivate" Style="{StaticResource OutlineButton}" MinWidth="170" Command="{Binding ToggleActiveCommand}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource AppCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Suppliers}"
                          SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="110" />
                        <DataGridTextColumn Header="SUPPLIER" Binding="{Binding Name}" Width="1.6*" />
                        <DataGridTextColumn Header="CONTACT" Binding="{Binding ContactPerson}" Width="1.2*" />
                        <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="140" />
                        <DataGridTextColumn Header="TOTAL PURCHASED" Binding="{Binding TotalPurchased, StringFormat=N2}" Width="130" />
                        <DataGridTextColumn Header="OUTSTANDING" Binding="{Binding Outstanding, StringFormat=N2}" Width="120" />
                        <DataGridTemplateColumn Header="STATUS" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IsActive}" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Inactive" />
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Text" Value="Active" />
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="11.5" Margin="12,8"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>