<UserControl x:Class="HighlandMilkBar.WPF.Views.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Backup &amp; Restore"
                             Subtitle="Protect your business data — create, verify and restore database backups." />

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,14,0,0">
            <controls:StatCard Title="BACKUP STATUS" Value="{Binding StatusText}" Caption="{Binding StatusCaption}"
                               Glyph="&#xE8B5;" Accent="{StaticResource SuccessBrush}" Margin="0,0,12,0" />
            <controls:StatCard Title="LAST BACKUP" Value="{Binding LastBackupText}" Caption="Most recent backup"
                               Glyph="&#xE8B5;" Accent="{StaticResource PrimaryBrush}" Margin="0,0,12,0" />
            <controls:StatCard Title="TOTAL BACKUPS" Value="{Binding TotalBackupsText}" Caption="Available backups"
                               Glyph="&#xE8B5;" Accent="{StaticResource AccentBrush}" />
        </UniformGrid>

        <UniformGrid Grid.Row="2" Columns="3" Margin="0,12,0,0">
            <controls:StatCard Title="STORAGE USED" Value="{Binding StorageUsedText}" Caption="Backup storage"
                               Glyph="&#xE8B5;" Accent="{StaticResource AccentBrush}" Margin="0,0,12,0" />
            <controls:StatCard Title="BACKUP LOCATION" Value="{Binding LocationText}" Caption="Destination folder"
                               Glyph="&#xE8B5;" Accent="{StaticResource PrimaryBrush}" Margin="0,0,12,0" />
            <controls:StatCard Title="NEXT AUTO BACKUP" Value="{Binding NextAutoText}" Caption="{Binding AutoStatusText}"
                               Glyph="&#xE8B5;" Accent="{StaticResource WarningBrush}" />
        </UniformGrid>

        <Border Grid.Row="3" Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="14">
            <StackPanel>
                <TextBlock Text="QUICK ACTIONS" Style="{StaticResource LabelText}" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Create Backup" Style="{StaticResource PrimaryButton}" MinWidth="130" Margin="0,0,10,0"
                            Command="{Binding CreateBackupCommand}" />
                    <Button Content="Restore Backup" Style="{StaticResource SecondaryButton}" MinWidth="130" Margin="0,0,10,0"
                            Click="Restore_Click" />
                    <Button Content="Verify" Style="{StaticResource OutlineButton}" MinWidth="100" Margin="0,0,10,0"
                            Click="Verify_Click" />
                    <Button Content="Open Folder" Style="{StaticResource OutlineButton}" MinWidth="110" Margin="0,0,10,0"
                            Command="{Binding OpenFolderCommand}" />
                    <Button Content="Settings" Style="{StaticResource GhostButton}" MinWidth="100"
                            Click="Settings_Click" />
                </StackPanel>
                <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding AutoSummary}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource AppCard}" Margin="0,12,0,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,12">
                    <TextBlock Text="BACKUP HISTORY" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Details" Style="{StaticResource GhostButton}" MinWidth="80" Margin="0,0,8,0" Click="Details_Click" />
                        <Button Content="Delete" Style="{StaticResource OutlineButton}" MinWidth="80" Margin="0,0,8,0" Click="Delete_Click" />
                        <Button Content="Refresh" Style="{StaticResource SecondaryButton}" MinWidth="90" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Backups}"
                          SelectedItem="{Binding SelectedBackup}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,0,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Backup Name" Binding="{Binding FileName}" Width="2*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="Auto" />
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtText}" Width="Auto" />
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="Auto" />
                        <DataGridTextColumn Header="Integrity" Binding="{Binding StatusText}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
            <Border Margin="0,6,0,0" Padding="10,6" CornerRadius="8" Background="{StaticResource DangerBrush}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Error}" Foreground="White" TextWrapping="Wrap" FontSize="12" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>