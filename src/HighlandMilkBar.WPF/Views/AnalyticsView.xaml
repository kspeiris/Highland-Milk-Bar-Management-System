<UserControl x:Class="HighlandMilkBar.WPF.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls"
             Loaded="AnalyticsView_Loaded">
    <UserControl.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="14,9" Margin="0,0,6,0">
                            <TextBlock x:Name="Lbl" Text="{TemplateBinding Header}" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Analytics"
                             Subtitle="Business-wide performance across sales, products, inventory, customers, milk bar, purchases and expenses.">
            <controls:PageHeader.HeaderContent>
                <StackPanel Orientation="Horizontal">
                    <ComboBox Style="{StaticResource AppComboBox}" MinWidth="140" Margin="0,0,8,0"
                              ItemsSource="{Binding PeriodOptions}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedPreset}" ToolTip="Reporting period" />
                    <Button Content="Refresh" Style="{StaticResource SecondaryButton}" MinWidth="100" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </controls:PageHeader.HeaderContent>
        </controls:PageHeader>

        <TextBlock Grid.Row="1" Text="{Binding PeriodLabel}" FontSize="12" Margin="2,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
        <Border Grid.Row="1" Margin="0,8,0,0" Padding="12,8" CornerRadius="9" Background="{StaticResource DangerBrush}"
                VerticalAlignment="Bottom" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Error}" Foreground="White" TextWrapping="Wrap" FontSize="12" />
        </Border>

        <TabControl Grid.Row="2" Margin="0,10,0,0">
            <!-- Sales -->
            <TabItem Header="Sales">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="5">
                        <controls:StatCard Title="GROSS SALES" Value="{Binding Sales.GrossSales, StringFormat=N0}" Caption="Before returns" Glyph="&#xE8C8;" Accent="{StaticResource PrimaryBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="NET SALES" Value="{Binding Sales.NetSales, StringFormat=N0}" Caption="After discounts/returns" Glyph="&#xE8C8;" Accent="{StaticResource SuccessBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="ORDERS" Value="{Binding Sales.Orders}" Caption="{Binding Sales.BestDay, StringFormat='Best: {0}'}" Glyph="&#xE8A5;" Accent="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="AVG ORDER VALUE" Value="{Binding Sales.AverageOrderValue, StringFormat=N0}" Caption="Net ÷ orders" Glyph="&#xE8C8;" Accent="{StaticResource PrimaryBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="UNITS SOLD" Value="{Binding Sales.UnitsSold, StringFormat=N0}" Caption="Quantity sold" Glyph="&#xE7EE;" Accent="{StaticResource AccentBrush}" />
                    </UniformGrid>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource AppCard}" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Sales trend" Style="{StaticResource CardHeadingText}" />
                                <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Sales.Trend}"
                                          AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PERIOD" Binding="{Binding Label}" Width="*" />
                                        <DataGridTextColumn Header="NET SALES" Binding="{Binding NetSales, StringFormat=N2}" Width="140" />
                                        <DataGridTextColumn Header="ORDERS" Binding="{Binding Orders}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource AppCard}">
                            <StackPanel>
                                <TextBlock Text="Sales by category" Style="{StaticResource CardHeadingText}" />
                                <ItemsControl ItemsSource="{Binding Sales.ByCategory}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="70" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding CategoryName}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="{Binding Percentage}"
                                                             Margin="0,0,10,0" Foreground="{StaticResource PrimaryBrush}" Background="{StaticResource PrimaryLightBrush}" BorderThickness="0" />
                                                <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat=N0}" FontSize="11.5" TextAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="By weekday" Style="{StaticResource CardHeadingText}" Margin="0,12,0,6" />
                                <ItemsControl ItemsSource="{Binding Sales.ByWeekday}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Day}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat=N0}" FontSize="12" TextAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Products -->
            <TabItem Header="Products">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource FlatCard}" Margin="0,0,8,8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Top sellers" Style="{StaticResource CardHeadingText}" />
                            <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Products.TopSellers}"
                                      AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="UNITS" Binding="{Binding UnitsSold, StringFormat=N0}" Width="70" />
                                    <DataGridTextColumn Header="REVENUE" Binding="{Binding Revenue, StringFormat=N0}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource FlatCard}" Margin="8,0,0,8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="High-profit products" Style="{StaticResource CardHeadingText}" />
                            <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Products.HighProfit}"
                                      AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="PROFIT" Binding="{Binding GrossProfit, StringFormat=N0}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource FlatCard}" Margin="0,8,8,0" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Low performers (by units)" Style="{StaticResource CardHeadingText}" />
                            <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Products.LowPerformers}"
                                      AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="UNITS" Binding="{Binding UnitsSold, StringFormat=N0}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FlatCard}" Margin="8,8,0,0" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="No sales this period" Style="{StaticResource CardHeadingText}" />
                            <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Products.NoSale}"
                                      AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" />
                                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding CategoryName}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Inventory -->
            <TabItem Header="Inventory">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="6">
                        <controls:StatCard Title="TRACKED" Value="{Binding Inventory.TrackedProducts}" Caption="Products" Glyph="&#xE7EE;" Accent="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="LOW STOCK" Value="{Binding Inventory.LowStockProducts}" Caption="Below reorder" Glyph="&#xE823;" Accent="{StaticResource WarningBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="EXPIRING" Value="{Binding Inventory.ExpiringSoonBatches}" Caption="Batches" Glyph="&#xE823;" Accent="{StaticResource WarningBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="EXPIRED" Value="{Binding Inventory.ExpiredBatches}" Caption="Batches" Glyph="&#xE823;" Accent="{StaticResource DangerBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="PHYSICAL VALUE" Value="{Binding Inventory.PhysicalStockValue, StringFormat=N0}" Caption="LKR" Glyph="&#xE8EC;" Accent="{StaticResource PrimaryBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="SELLABLE VALUE" Value="{Binding Inventory.SellableStockValue, StringFormat=N0}" Caption="LKR" Glyph="&#xE8EC;" Accent="{StaticResource SuccessBrush}" />
                    </UniformGrid>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,8,0" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Low-stock alerts" Style="{StaticResource CardHeadingText}" />
                                <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Inventory.LowStockAlerts}"
                                          AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="*" />
                                        <DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="160" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource FlatCard}" Margin="8,0,0,0" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Expiry alerts" Style="{StaticResource CardHeadingText}" />
                                <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Inventory.ExpiryAlerts}"
                                          AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="*" />
                                        <DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="160" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Customers -->
            <TabItem Header="Customers">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="5">
                        <controls:StatCard Title="TOTAL" Value="{Binding Customers.TotalCustomers}" Caption="Registered" Glyph="&#xE7EE;" Accent="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="ACTIVE" Value="{Binding Customers.ActiveCustomers}" Caption="With purchases" Glyph="&#xE7EE;" Accent="{StaticResource SuccessBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="NEW" Value="{Binding Customers.NewThisMonth}" Caption="This month" Glyph="&#xE7EE;" Accent="{StaticResource PrimaryBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="REPEAT" Value="{Binding Customers.RepeatCustomers}" Caption="Repeat buyers" Glyph="&#xE7EE;" Accent="{StaticResource PrimaryBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="AVG SPEND" Value="{Binding Customers.AverageCustomerSpending, StringFormat=N0}" Caption="Per customer" Glyph="&#xE8C8;" Accent="{StaticResource AccentBrush}" />
                    </UniformGrid>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,8,0" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Top customers by spending" Style="{StaticResource CardHeadingText}" />
                                <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Customers.TopCustomersBySpending}"
                                          AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CUSTOMER" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="SPEND" Binding="{Binding TotalSpending, StringFormat=N2}" Width="120" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource FlatCard}" Margin="8,0,0,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Segments" Style="{StaticResource CardHeadingText}" />
                                <ItemsControl ItemsSource="{Binding Customers.SegmentCounts}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SegmentText}" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="12" TextAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Milk Bar -->
            <TabItem Header="Milk Bar">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="5">
                        <controls:StatCard Title="MENU ITEMS" Value="{Binding MilkBar.TotalMenuItems}" Caption="Prepared products" Glyph="&#xE7EE;" Accent="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="ACTIVE RECIPES" Value="{Binding MilkBar.ActiveRecipes}" Caption="Ready" Glyph="&#xE8EC;" Accent="{StaticResource SuccessBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="INGREDIENTS" Value="{Binding MilkBar.TotalIngredientsUsed}" Caption="Used" Glyph="&#xE8EC;" Accent="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="LOW INGREDIENTS" Value="{Binding MilkBar.LowStockIngredients}" Caption="Low stock" Glyph="&#xE823;" Accent="{StaticResource WarningBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="AVG MARGIN" Value="{Binding MilkBar.AverageMarginPercent, StringFormat={}{0:N1}%}" Caption="Estimated" Glyph="&#xE9D9;" Accent="{StaticResource PrimaryBrush}" />
                    </UniformGrid>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,8,0" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Highest estimated margin" Style="{StaticResource CardHeadingText}" />
                                <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding MilkBar.HighestMarginProducts}"
                                          AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="MENU ITEM" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="PRICE" Binding="{Binding SellingPrice, StringFormat=N0}" Width="90" />
                                        <DataGridTextColumn Header="MARGIN %" Binding="{Binding MarginPercent, StringFormat={}{0:N1}}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource FlatCard}" Margin="8,0,0,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Milk bar alerts" Style="{StaticResource CardHeadingText}" />
                                <ItemsControl ItemsSource="{Binding MilkBar.Alerts}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="10,7" CornerRadius="8" Background="{StaticResource BackgroundBrush}">
                                                <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Purchases -->
            <TabItem Header="Purchases">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="4">
                        <controls:StatCard Title="RECEIVED" Value="{Binding Purchases.TotalReceivedPurchases}" Caption="Purchases" Glyph="&#xE8EC;" Accent="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="PURCHASE VALUE" Value="{Binding Purchases.PurchaseValue, StringFormat=N0}" Caption="LKR" Glyph="&#xE8C8;" Accent="{StaticResource PrimaryBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="SUPPLIERS" Value="{Binding Purchases.ActiveSuppliers}" Caption="Active" Glyph="&#xE7EE;" Accent="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="OUTSTANDING" Value="{Binding Purchases.OutstandingPayments, StringFormat=N0}" Caption="Payables (LKR)" Glyph="&#xE823;" Accent="{StaticResource DangerBrush}" />
                    </UniformGrid>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FlatCard}" Margin="0,0,8,0" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Purchase value by supplier" Style="{StaticResource CardHeadingText}" />
                                <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Purchases.BySupplier}"
                                          AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="SUPPLIER" Binding="{Binding SupplierName}" Width="*" />
                                        <DataGridTextColumn Header="VALUE" Binding="{Binding Value, StringFormat=N0}" Width="120" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource FlatCard}" Margin="8,0,0,0" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Top purchased products" Style="{StaticResource CardHeadingText}" />
                                <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Purchases.TopPurchased}"
                                          AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PRODUCT" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="QTY" Binding="{Binding Quantity, StringFormat=N0}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Expenses -->
            <TabItem Header="Expenses">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="3">
                        <controls:StatCard Title="TOTAL EXPENSES" Value="{Binding Expenses.TotalAmount, StringFormat=N0}" Caption="LKR" Glyph="&#xE8C8;" Accent="{StaticResource DangerBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="COUNT" Value="{Binding Expenses.ExpenseCount}" Caption="Transactions" Glyph="&#xE8A5;" Accent="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                        <controls:StatCard Title="AVERAGE" Value="{Binding Expenses.AverageAmount, StringFormat=N0}" Caption="Per expense" Glyph="&#xE8C8;" Accent="{StaticResource AccentBrush}" />
                    </UniformGrid>

                    <Border Grid.Row="1" Style="{StaticResource FlatCard}" Margin="0,14,0,0" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Expense by category" Style="{StaticResource CardHeadingText}" />
                            <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Expenses.ByCategory}"
                                      AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding CategoryName}" Width="*" />
                                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding TotalAmount, StringFormat=N2}" Width="140" />
                                    <DataGridTextColumn Header="COUNT" Binding="{Binding ExpenseCount}" Width="90" />
                                    <DataGridTextColumn Header="SHARE" Binding="{Binding Percentage, StringFormat={}{0:N1}%}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>