<Window x:Class="HighlandMilkBar.WPF.Views.PurchaseDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls"
        Title="Purchase details" Width="1040" Height="800" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="HeaderTitle" Text="{Binding PurchaseNumber}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border Margin="14,0,0,0" Padding="10,3" CornerRadius="10" Background="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ReceiveStatusText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                </Border>
                <Border Margin="8,0,0,0" Padding="10,3" CornerRadius="10" Background="{StaticResource BackgroundBrush}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PaymentStatusText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>
            <TextBlock Text="{Binding SupplierName}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <UniformGrid Columns="4">
                    <controls:StatCard Title="SUBTOTAL (LKR)" Value="{Binding Subtotal, StringFormat=N0}" Caption="Items total" Glyph="◫" Accent="{StaticResource PrimaryBrush}" Margin="0,0,12,0" />
                    <controls:StatCard Title="ADJUSTMENTS (LKR)" Value="{Binding AdditionalCharges, StringFormat=N0}" Caption="Discount &amp; charges" Glyph="±" Accent="{StaticResource AmberBrush}" Margin="0,0,12,0" />
                    <controls:StatCard Title="TOTAL (LKR)" Value="{Binding TotalAmount, StringFormat=N0}" Caption="Grand total" Glyph="＄" Accent="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                    <controls:StatCard Title="OUTSTANDING (LKR)" Value="{Binding Outstanding, StringFormat=N0}" Caption="Balance due" Glyph="◷" Accent="{StaticResource DangerBrush}" />
                </UniformGrid>

                <Border Style="{StaticResource AppCard}" Padding="0" Margin="0,16,0,0">
                    <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="2*" />
                            <DataGridTextColumn Header="QTY" Binding="{Binding Quantity, StringFormat=N3}" Width="80" />
                            <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="80" />
                            <DataGridTextColumn Header="COST" Binding="{Binding UnitCost, StringFormat=N2}" Width="90" />
                            <DataGridTextColumn Header="DISCOUNT" Binding="{Binding DiscountAmount, StringFormat=N2}" Width="90" />
                            <DataGridTextColumn Header="LINE TOTAL" Binding="{Binding LineTotal, StringFormat=N2}" Width="110" />
                            <DataGridTextColumn Header="BATCH" Binding="{Binding BatchNumber}" Width="120" />
                            <DataGridTextColumn Header="EXPIRY" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource AppCard}" Padding="0">
                        <StackPanel>
                            <TextBlock Text="PAYMENT HISTORY" Style="{StaticResource LabelText}" Margin="16,16,16,8" />
                            <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Payments}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="240">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DATE" Binding="{Binding PaidAt, StringFormat=yyyy-MM-dd}" Width="110" />
                                    <DataGridTextColumn Header="METHOD" Binding="{Binding Method}" Width="110" />
                                    <DataGridTextColumn Header="REFERENCE" Binding="{Binding Reference}" Width="*" />
                                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=N2}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource AppCard}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="RECORD PAYMENT" Style="{StaticResource LabelText}" Margin="0,0,0,12" />
                            <TextBlock Text="AMOUNT (LKR)" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <TextBox Style="{StaticResource InputTextBox}" Margin="0,0,0,12"
                                     Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="METHOD" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <ComboBox Style="{StaticResource AppComboBox}" Margin="0,0,0,12"
                                      ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" />
                            <TextBlock Text="REFERENCE" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <TextBox Style="{StaticResource InputTextBox}" Margin="0,0,0,14"
                                     Text="{Binding PaymentReference, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Record payment" Style="{StaticResource PrimaryButton}" MinWidth="150"
                                    HorizontalAlignment="Stretch" Command="{Binding RecordPaymentCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="2,12,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Info}" Foreground="{StaticResource SuccessBrush}" FontSize="12" TextWrapping="Wrap" Margin="2,12,0,0"
                           Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Receive purchase" Style="{StaticResource PrimaryButton}" MinWidth="160" Margin="0,0,10,0"
                    Command="{Binding ReceiveCommand}" Visibility="{Binding CanReceive, Converter={StaticResource BoolToVis}}" />
            <Button Content="Close" Style="{StaticResource OutlineButton}" MinWidth="90" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>