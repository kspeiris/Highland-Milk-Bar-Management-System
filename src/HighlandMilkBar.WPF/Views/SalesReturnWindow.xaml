<Window x:Class="HighlandMilkBar.WPF.Views.SalesReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process return" Width="760" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="HeaderText" FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="SubHeaderText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <Border Style="{StaticResource AppCard}" Padding="0">
            <DataGrid x:Name="ItemsGrid" Style="{StaticResource AppDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                    <DataGridTextColumn Header="SOLD" Binding="{Binding SoldQuantity, StringFormat={}{0:0.###}}" Width="70" IsReadOnly="True" />
                    <DataGridTextColumn Header="UNIT PRICE" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="100" IsReadOnly="True" />
                    <DataGridTextColumn Header="RETURN QTY" Binding="{Binding ReturnQuantityText, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                    <DataGridTemplateColumn Header="CONDITION" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding ConditionOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding Condition, Mode=TwoWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="REFUND" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="100" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Reason" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Style="{StaticResource InputTextBox}" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="REFUND TOTAL" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="RefundText" FontWeight="Bold" FontSize="15"
                           Foreground="{StaticResource PrimaryBrush}" />
            </Grid>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                       Foreground="{StaticResource DangerBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" MinWidth="90" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="Submit return" Style="{StaticResource PrimaryButton}" MinWidth="130" Click="Submit_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>