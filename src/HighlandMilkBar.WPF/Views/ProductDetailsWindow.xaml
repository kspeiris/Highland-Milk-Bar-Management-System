<Window x:Class="HighlandMilkBar.WPF.Views.ProductDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls"
        Title="Product details" Width="560" Height="720" MinWidth="500" MinHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Sku, StringFormat='SKU: {0}'}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="GENERAL" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <Border Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Barcode" Style="{StaticResource SecondaryText}" Margin="0,6" />
                        <TextBlock Grid.Column="1" Text="{Binding Barcode}" Margin="0,6" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="Category" Style="{StaticResource SecondaryText}" Margin="0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CategoryName}" Margin="0,6" />
                        <TextBlock Grid.Row="2" Text="Type" Style="{StaticResource SecondaryText}" Margin="0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TypeName}" Margin="0,6" />
                        <TextBlock Grid.Row="3" Text="Unit" Style="{StaticResource SecondaryText}" Margin="0,6" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Unit}" Margin="0,6" />
                        <TextBlock Grid.Row="4" Text="Status" Style="{StaticResource SecondaryText}" Margin="0,6" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding StatusText}" Margin="0,6" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="5" Text="Created" Style="{StaticResource SecondaryText}" Margin="0,6" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,6"
                                   Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                    </Grid>
                </Border>

                <TextBlock Text="PRICING (LKR)" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <Border Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="Purchase price" Style="{StaticResource SecondaryText}" Margin="0,6" />
                        <TextBlock Grid.Column="1" Margin="0,6" Text="{Binding CostPrice, StringFormat='LKR {0:N2}'}" />
                        <TextBlock Grid.Row="1" Text="Selling price" Style="{StaticResource SecondaryText}" Margin="0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6" Text="{Binding SellingPrice, StringFormat='LKR {0:N2}'}" />
                    </Grid>
                </Border>

                <TextBlock Text="INVENTORY" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <Border Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="Track inventory" Style="{StaticResource SecondaryText}" Margin="0,6" />
                        <TextBlock Grid.Column="1" Margin="0,6" Text="{Binding TrackInventory}" />
                        <TextBlock Grid.Row="1" Text="Current stock" Style="{StaticResource SecondaryText}" Margin="0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6" Text="{Binding CurrentStock, StringFormat='{}{0:N3}'}" />
                        <TextBlock Grid.Row="2" Text="Reorder level" Style="{StaticResource SecondaryText}" Margin="0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6" Text="{Binding ReorderLevel, StringFormat='{}{0:N3}'}" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding UpdatedAt, StringFormat='Last updated: {0:yyyy-MM-dd HH:mm}'}"
                           Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Close" Style="{StaticResource SecondaryButton}" MinWidth="100"
                HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True" Click="Close_Click" />
    </Grid>
</Window>