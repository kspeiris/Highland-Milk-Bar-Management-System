<UserControl x:Class="HighlandMilkBar.WPF.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls"
             Loaded="ProductsView_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <controls:PageHeader Grid.Row="0" Title="Products" Subtitle="Create and maintain the items sold at your Highland Milk Bar.">
            <controls:PageHeader.HeaderContent>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Categories" Style="{StaticResource SecondaryButton}" MinWidth="110"
                            Margin="0,0,10,0" Click="Categories_Click" />
                    <Button Content="＋  Add product" Style="{StaticResource PrimaryButton}" MinWidth="140"
                            Click="AddProduct_Click" />
                </StackPanel>
            </controls:PageHeader.HeaderContent>
        </controls:PageHeader>

        <!-- Stats -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,0">
            <controls:StatCard Title="TOTAL PRODUCTS" Value="{Binding TotalProducts}" Caption="All items in catalogue"
                               Glyph="▤" Accent="{StaticResource PrimaryBrush}" Margin="0,0,12,0" />
            <controls:StatCard Title="ACTIVE" Value="{Binding ActiveProducts}" Caption="Available for sale"
                               Glyph="✓" Accent="{StaticResource SuccessBrush}" Margin="0,0,12,0" />
            <controls:StatCard Title="INACTIVE" Value="{Binding InactiveProducts}" Caption="Hidden from POS"
                               Glyph="∅" Accent="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
            <controls:StatCard Title="CATEGORIES" Value="{Binding CategoriesCount}" Caption="Product categories"
                               Glyph="◈" Accent="{StaticResource AccentBrush}" />
        </UniformGrid>

        <!-- Filters -->
        <Border Grid.Row="2" Style="{StaticResource FlatCard}" Margin="0,16,0,0" Padding="14">
            <StackPanel Orientation="Horizontal">
                <Border Width="240" Margin="0,0,10,0">
                    <controls:SearchBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
                <ComboBox Style="{StaticResource AppComboBox}" MinWidth="160" Margin="0,0,10,0"
                          ItemsSource="{Binding CategoryFilterOptions}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedCategory}" ToolTip="Filter by category" />
                <ComboBox Style="{StaticResource AppComboBox}" MinWidth="140" Margin="0,0,10,0"
                          ItemsSource="{Binding TypeOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedType}" ToolTip="Filter by product type" />
                <ComboBox Style="{StaticResource AppComboBox}" MinWidth="130" Margin="0,0,10,0"
                          ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedStatus}" ToolTip="Filter by status" />
                <Button Content="Search" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="0,0,8,0"
                        Command="{Binding SearchCommand}" />
                <Button Content="Clear" Style="{StaticResource OutlineButton}" MinWidth="80"
                        Command="{Binding ClearFiltersCommand}" />
            </StackPanel>
        </Border>

        <!-- Action bar -->
        <Grid Grid.Row="3" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Edit" Style="{StaticResource SecondaryButton}" MinWidth="80" Margin="0,0,8,0"
                        Click="EditProduct_Click" />
                <Button Content="Details" Style="{StaticResource OutlineButton}" MinWidth="90" Margin="0,0,8,0"
                        Click="DetailsProduct_Click" />
                <Button Content="Activate / Deactivate" Style="{StaticResource OutlineButton}" MinWidth="170"
                        Command="{Binding SetActiveCommand}" CommandParameter="{Binding SelectedProduct}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="‹" Style="{StaticResource IconButton}" Command="{Binding PreviousPageCommand}" ToolTip="Previous page" />
                <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="8,0" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Button Content="›" Style="{StaticResource IconButton}" Command="{Binding NextPageCommand}" ToolTip="Next page" />
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- Grid -->
        <Border Grid.Row="4" Style="{StaticResource AppCard}" Padding="0">
            <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" />
                    <DataGridTextColumn Header="BARCODE" Binding="{Binding Barcode}" Width="120" />
                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding CategoryName}" Width="1.2*" />
                    <DataGridTextColumn Header="TYPE" Binding="{Binding TypeName}" Width="110" />
                    <DataGridTextColumn Header="COST (LKR)" Binding="{Binding CostPrice, StringFormat={}{0:N2}}" Width="100" />
                    <DataGridTextColumn Header="SELL (LKR)" Binding="{Binding SellingPrice, StringFormat={}{0:N2}}" Width="105" />
                    <DataGridTextColumn Header="STOCK" Binding="{Binding CurrentStock, StringFormat={}{0:N3}}" Width="90" />
                    <DataGridTemplateColumn Header="STATUS" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>