<UserControl x:Class="HighlandMilkBar.WPF.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls"
             xmlns:vm="clr-namespace:HighlandMilkBar.WPF.ViewModels"
             xmlns:views="clr-namespace:HighlandMilkBar.WPF.Views"
             Loaded="InventoryView_Loaded">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:InventoryOverviewViewModel}">
            <views:InventoryOverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockOverviewViewModel}">
            <views:StockOverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatchViewModel}">
            <views:BatchManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockInViewModel}">
            <views:StockInView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockAdjustmentViewModel}">
            <views:StockAdjustmentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockMovementViewModel}">
            <views:StockMovementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExpiryViewModel}">
            <views:ExpiryView />
        </DataTemplate>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9"
                                Padding="16,9" Margin="0,0,6,0">
                            <TextBlock x:Name="Lbl" Text="{TemplateBinding Header}" FontSize="13"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Inventory"
                             Subtitle="Batch-level stock, receipts, adjustments, expiry and movement history.">
            <controls:PageHeader.HeaderContent>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Refresh" Style="{StaticResource SecondaryButton}" MinWidth="110"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </controls:PageHeader.HeaderContent>
        </controls:PageHeader>

        <TabControl Grid.Row="1" Margin="0,14,0,0">
            <TabItem Header="Overview">
                <ContentControl Content="{Binding Overview}" />
            </TabItem>
            <TabItem Header="Stock">
                <ContentControl Content="{Binding Stock}" />
            </TabItem>
            <TabItem Header="Batches">
                <ContentControl Content="{Binding Batches}" />
            </TabItem>
            <TabItem Header="Stock In">
                <ContentControl Content="{Binding StockIn}" />
            </TabItem>
            <TabItem Header="Adjustments">
                <ContentControl Content="{Binding Adjustments}" />
            </TabItem>
            <TabItem Header="Movements">
                <ContentControl Content="{Binding Movements}" />
            </TabItem>
            <TabItem Header="Expiry">
                <ContentControl Content="{Binding Expiry}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>