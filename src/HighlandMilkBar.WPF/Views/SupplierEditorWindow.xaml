<Window x:Class="HighlandMilkBar.WPF.Views.SupplierEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supplier" Width="620" Height="760" MinWidth="560" MinHeight="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeaderTitle" Text="Add supplier" FontSize="22" FontWeight="Bold" />
            <TextBlock x:Name="HeaderSubtitle" Text="Enter the supplier details. You can update these values later."
                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="SUPPLIER DETAILS" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <Border Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="SUPPLIER NAME *" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                        <TextBox x:Name="NameInput" Style="{StaticResource InputTextBox}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SUPPLIER CODE" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <TextBox x:Name="CodeInput" Style="{StaticResource InputTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CONTACT PERSON" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <TextBox x:Name="ContactInput" Style="{StaticResource InputTextBox}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PHONE" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <TextBox x:Name="PhoneInput" Style="{StaticResource InputTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="EMAIL" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <TextBox x:Name="EmailInput" Style="{StaticResource InputTextBox}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="ADDRESS" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                        <TextBox x:Name="AddressInput" Style="{StaticResource InputTextBox}" Margin="0,0,0,12" />
                    </StackPanel>
                </Border>

                <TextBlock Text="REGISTRATION" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <Border Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="BUSINESS REGISTRATION NO." Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <TextBox x:Name="BizRegInput" Style="{StaticResource InputTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TAX REGISTRATION NO." Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <TextBox x:Name="TaxRegInput" Style="{StaticResource InputTextBox}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="NOTES" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <Border Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBox x:Name="NotesInput" Style="{StaticResource InputTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
                        <CheckBox x:Name="ActiveInput" Content="Supplier is active" IsChecked="True" Margin="0,12,0,0"
                                  Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" MinWidth="100" Margin="0,0,10,0"
                        Click="Cancel_Click" />
                <Button x:Name="SaveButton" Content="Save supplier" Style="{StaticResource PrimaryButton}" MinWidth="150"
                        Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>