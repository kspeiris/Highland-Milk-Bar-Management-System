<Window x:Class="HighlandMilkBar.WPF.Views.CategoryManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls"
        Title="Category management" Width="900" Height="680" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Categories" Subtitle="Create and maintain product categories.">
            <controls:PageHeader.HeaderContent>
                <Button Content="＋  New category" Style="{StaticResource PrimaryButton}" MinWidth="150" Click="NewCategory_Click" />
            </controls:PageHeader.HeaderContent>
        </controls:PageHeader>

        <Border Grid.Row="1" Style="{StaticResource FlatCard}" Padding="14" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <Border Width="260" Margin="0,0,10,0">
                    <controls:SearchBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
                <ComboBox Style="{StaticResource AppComboBox}" MinWidth="140" Margin="0,0,10,0"
                          ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedStatus}" ToolTip="Filter by status" />
                <Button Content="Search" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="0,0,8,0"
                        Command="{Binding SearchCommand}" />
                <Button Content="Clear" Style="{StaticResource OutlineButton}" MinWidth="80"
                        Command="{Binding ClearFiltersCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,10,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Edit" Style="{StaticResource SecondaryButton}" MinWidth="80" Margin="0,0,8,0" Click="EditCategory_Click" />
                <Button Content="Activate / Deactivate" Style="{StaticResource OutlineButton}" MinWidth="170"
                        Command="{Binding SetActiveCommand}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource AppCard}" Padding="0">
            <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="2*" />
                    <DataGridTextColumn Header="PRODUCTS" Binding="{Binding ProductCount}" Width="90" />
                    <DataGridTemplateColumn Header="STATUS" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>