<Window x:Class="HighlandMilkBar.WPF.Views.ExpenseEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Expense" Width="600" Height="720" MinWidth="540" MinHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeaderTitle" Text="Add expense" FontSize="22" FontWeight="Bold" />
            <TextBlock x:Name="HeaderSubtitle" Text="Record an operating expense. This never affects sales or supplier balances."
                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="EXPENSE DETAILS" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <Border Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="DESCRIPTION *" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                        <TextBox x:Name="DescriptionInput" Style="{StaticResource InputTextBox}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="AMOUNT (LKR) *" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <TextBox x:Name="AmountInput" Style="{StaticResource InputTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="EXPENSE DATE *" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <DatePicker x:Name="DateInput" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CATEGORY" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <ComboBox x:Name="CategoryInput" Style="{StaticResource AppComboBox}" DisplayMemberPath="Name" SelectedValuePath="Id" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PAYMENT METHOD" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <ComboBox x:Name="MethodInput" Style="{StaticResource AppComboBox}" SelectedIndex="0">
                                    <ComboBoxItem Content="Cash" />
                                    <ComboBoxItem Content="Card" />
                                    <ComboBoxItem Content="Bank transfer" />
                                    <ComboBoxItem Content="Cheque" />
                                    <ComboBoxItem Content="Other" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="REFERENCE (INVOICE / RECEIPT NO.)" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                        <TextBox x:Name="ReferenceInput" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="NOTES" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <Border Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,14">
                    <TextBox x:Name="NotesInput" Style="{StaticResource InputTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" MinWidth="100" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button x:Name="SaveButton" Content="Save expense" Style="{StaticResource PrimaryButton}" MinWidth="150" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>