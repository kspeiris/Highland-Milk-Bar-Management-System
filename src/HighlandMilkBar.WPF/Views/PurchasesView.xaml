<UserControl x:Class="HighlandMilkBar.WPF.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls"
             Loaded="PurchasesView_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Purchases" Subtitle="Record supplier invoices and receive goods into inventory.">
            <controls:PageHeader.HeaderContent>
                <Button Content="＋  New purchase" Style="{StaticResource PrimaryButton}" MinWidth="150" Command="{Binding NewCommand}" />
            </controls:PageHeader.HeaderContent>
        </controls:PageHeader>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,18,0,0">
            <controls:StatCard Title="RECEIVED PURCHASES" Value="{Binding TotalReceivedPurchases}" Caption="Goods received" Glyph="⇩" Accent="{StaticResource PrimaryBrush}" Margin="0,0,12,0" />
            <controls:StatCard Title="PURCHASE VALUE (LKR)" Value="{Binding PurchaseValue, StringFormat=N0}" Caption="Received purchase value" Glyph="◫" Accent="{StaticResource AccentBrush}" Margin="0,0,12,0" />
            <controls:StatCard Title="ACTIVE SUPPLIERS" Value="{Binding ActiveSuppliers}" Caption="Available to order" Glyph="♧" Accent="{StaticResource SuccessBrush}" />
        </UniformGrid>
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,12,0,0">
            <controls:StatCard Title="OUTSTANDING (LKR)" Value="{Binding OutstandingPayments, StringFormat=N0}" Caption="Unpaid supplier balances" Glyph="◷" Accent="{StaticResource DangerBrush}" Margin="0,0,12,0" />
            <controls:StatCard Title="PAID THIS MONTH (LKR)" Value="{Binding PaymentsThisMonth, StringFormat=N0}" Caption="Supplier payments" Glyph="✓" Accent="{StaticResource SuccessBrush}" Margin="0,0,12,0" />
            <controls:StatCard Title="PURCHASES THIS MONTH" Value="{Binding PurchasesThisMonth}" Caption="Received this month" Glyph="▤" Accent="{StaticResource PrimaryBrush}" />
        </UniformGrid>

        <Border Grid.Row="3" Style="{StaticResource FlatCard}" Margin="0,16,0,0" Padding="14">
            <StackPanel Orientation="Horizontal">
                <Border Width="220" Margin="0,0,10,0">
                    <controls:SearchBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
                <ComboBox Style="{StaticResource AppComboBox}" MinWidth="170" Margin="0,0,10,0"
                          ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSupplier}" ToolTip="Filter by supplier" />
                <ComboBox Style="{StaticResource AppComboBox}" MinWidth="150" Margin="0,0,10,0"
                          ItemsSource="{Binding ReceiveStatusOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedReceiveStatus}" ToolTip="Receiving status" />
                <ComboBox Style="{StaticResource AppComboBox}" MinWidth="160" Margin="0,0,10,0"
                          ItemsSource="{Binding PaymentStatusOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedPaymentStatus}" ToolTip="Payment status" />
                <Button Content="Search" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="0,0,8,0" Command="{Binding SearchCommand}" />
                <Button Content="Clear" Style="{StaticResource OutlineButton}" MinWidth="80" Command="{Binding ClearFiltersCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Edit" Style="{StaticResource SecondaryButton}" MinWidth="80" Margin="0,0,8,0" Command="{Binding EditCommand}" />
                <Button Content="Receive" Style="{StaticResource PrimaryButton}" MinWidth="100" Margin="0,0,8,0" Command="{Binding ReceiveCommand}" />
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" MinWidth="90" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
                <Button Content="Details" Style="{StaticResource OutlineButton}" MinWidth="90" Command="{Binding DetailsCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="‹" Style="{StaticResource IconButton}" Command="{Binding PreviousPageCommand}" ToolTip="Previous page" />
                <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="8,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <Button Content="›" Style="{StaticResource IconButton}" Command="{Binding NextPageCommand}" ToolTip="Next page" />
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="5" Style="{StaticResource AppCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Purchases}"
                          SelectedItem="{Binding SelectedPurchase, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PURCHASE" Binding="{Binding PurchaseNumber}" Width="150" />
                        <DataGridTextColumn Header="INVOICE" Binding="{Binding InvoiceNumber}" Width="130" />
                        <DataGridTextColumn Header="SUPPLIER" Binding="{Binding SupplierName}" Width="1.4*" />
                        <DataGridTextColumn Header="DATE" Binding="{Binding PurchaseDate, StringFormat=yyyy-MM-dd}" Width="110" />
                        <DataGridTextColumn Header="ITEMS" Binding="{Binding ItemCount}" Width="70" />
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalAmount, StringFormat=N2}" Width="110" />
                        <DataGridTextColumn Header="PAID" Binding="{Binding AmountPaid, StringFormat=N2}" Width="100" />
                        <DataGridTextColumn Header="OUTSTANDING" Binding="{Binding Outstanding, StringFormat=N2}" Width="110" />
                        <DataGridTemplateColumn Header="STATUS" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ReceiveStatus}" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ReceiveStatus}" Value="Received">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ReceiveStatus}" Value="Cancelled">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PAYMENT" Binding="{Binding PaymentStatus}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="11.5" Margin="12,8"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>