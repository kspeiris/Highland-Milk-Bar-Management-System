<UserControl x:Class="HighlandMilkBar.WPF.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls"
             Loaded="CustomersView_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Customers" Subtitle="Manage customer records, purchase history and loyalty.">
            <controls:PageHeader.HeaderContent>
                <Button Content="&#xF0E7;  New customer" Style="{StaticResource PrimaryButton}" MinWidth="150" Command="{Binding NewCommand}" />
            </controls:PageHeader.HeaderContent>
        </controls:PageHeader>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,18,0,0">
            <controls:StatCard Title="TOTAL CUSTOMERS" Value="{Binding TotalCustomers}" Caption="Registered" Glyph="&#xE77B;" Accent="{StaticResource PrimaryBrush}" Margin="0,0,12,0" />
            <controls:StatCard Title="ACTIVE CUSTOMERS" Value="{Binding ActiveCustomers}" Caption="Selectable at POS" Glyph="&#xE73E;" Accent="{StaticResource SuccessBrush}" Margin="0,0,12,0" />
            <controls:StatCard Title="NEW THIS MONTH" Value="{Binding NewThisMonth}" Caption="Registered this month" Glyph="&#xE7C8;" Accent="{StaticResource AccentBrush}" />
        </UniformGrid>
        <UniformGrid Grid.Row="2" Columns="2" Margin="0,12,0,0">
            <controls:StatCard Title="REPEAT CUSTOMERS" Value="{Binding RepeatCustomers}" Caption="2+ completed sales" Glyph="&#xE8CB;" Accent="{StaticResource AccentBrush}" Margin="0,0,12,0" />
            <controls:StatCard Title="TOTAL CUSTOMER SALES (LKR)" Value="{Binding TotalCustomerSales, StringFormat=N0}" Caption="Linked sale value" Glyph="&#xE8C8;" Accent="{StaticResource SuccessBrush}" />
        </UniformGrid>

        <Border Grid.Row="3" Style="{StaticResource FlatCard}" Margin="0,16,0,0" Padding="14">
            <StackPanel Orientation="Horizontal">
                <Border Width="220" Margin="0,0,10,0">
                    <controls:SearchBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
                <ComboBox Style="{StaticResource AppComboBox}" MinWidth="140" Margin="0,0,10,0"
                          ItemsSource="{Binding TypeOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedType}" ToolTip="Filter by customer type" />
                <ComboBox Style="{StaticResource AppComboBox}" MinWidth="140" Margin="0,0,10,0"
                          ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedStatus}" ToolTip="Filter by status" />
                <ComboBox Style="{StaticResource AppComboBox}" MinWidth="150" Margin="0,0,10,0"
                          ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSort}" ToolTip="Sort order" />
                <Button Content="Search" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="0,0,8,0" Command="{Binding SearchCommand}" />
                <Button Content="Clear" Style="{StaticResource OutlineButton}" MinWidth="80" Command="{Binding ClearFiltersCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Edit" Style="{StaticResource SecondaryButton}" MinWidth="80" Margin="0,0,8,0" Command="{Binding EditCommand}" />
                <Button Content="View profile" Style="{StaticResource OutlineButton}" MinWidth="110" Margin="0,0,8,0" Command="{Binding DetailsCommand}" />
                <Button Content="Activate / Deactivate" Style="{StaticResource OutlineButton}" MinWidth="170" Margin="0,0,8,0" Command="{Binding ToggleActiveCommand}" />
                <Button Content="Delete" Style="{StaticResource OutlineButton}" MinWidth="90" Margin="0,0,8,0" Command="{Binding DeleteCommand}" />
                <Button Content="Analytics" Style="{StaticResource GhostButton}" MinWidth="100" Command="{Binding AnalyticsCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="&#xE00E;" Style="{StaticResource IconButton}" Command="{Binding PreviousPageCommand}" ToolTip="Previous page" />
                <TextBlock Text="{Binding PageDisplay}" VerticalAlignment="Center" Margin="8,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <Button Content="&#xE010;" Style="{StaticResource IconButton}" Command="{Binding NextPageCommand}" ToolTip="Next page" />
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="5" Style="{StaticResource AppCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Customers}"
                          SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CODE" Binding="{Binding CustomerCode}" Width="120" />
                        <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.5*" />
                        <DataGridTextColumn Header="TYPE" Binding="{Binding TypeText}" Width="100" />
                        <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="130" />
                        <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="1.3*" />
                        <DataGridTextColumn Header="PURCHASES" Binding="{Binding TotalPurchases}" Width="90" />
                        <DataGridTextColumn Header="SPENDING (LKR)" Binding="{Binding TotalSpending, StringFormat=N2}" Width="130" />
                        <DataGridTextColumn Header="LAST PURCHASE" Binding="{Binding LastPurchase, StringFormat=yyyy-MM-dd}" Width="120" />
                        <DataGridTemplateColumn Header="STATUS" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="11.5" Margin="12,8"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>