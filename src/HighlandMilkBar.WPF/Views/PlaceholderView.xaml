<UserControl x:Class="HighlandMilkBar.WPF.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Background="White" CornerRadius="16" BorderBrush="#E8EDF3" BorderThickness="1" Padding="34" MaxWidth="850" MaxHeight="540" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="18" Background="#EAF3FB" HorizontalAlignment="Center">
                    <TextBlock Text="✦" FontSize="30" Foreground="#1769AA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Background="#FFF4E5" CornerRadius="12" Padding="10,5" Margin="0,20,0,12" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="#9A6518" />
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#718096" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="620" LineHeight="21" Margin="0,12,0,20" />
                <Border Background="#F5F8FC" CornerRadius="10" Padding="16" MaxWidth="600">
                    <StackPanel>
                        <TextBlock Text="Included in the project roadmap" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="This starter build establishes the application shell, local database, dashboard and product catalogue. The remaining modules will be delivered incrementally with your coding agent." FontSize="10.5" Foreground="#8794A4" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
