<Window x:Class="HighlandMilkBar.WPF.Views.CustomerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer" Width="620" Height="820" MinWidth="560" MinHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeaderTitle" Text="Add customer" FontSize="22" FontWeight="Bold" />
            <TextBlock x:Name="HeaderSubtitle" Text="Enter the customer details. You can update these values later."
                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="CUSTOMER DETAILS" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <Border Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CUSTOMER CODE" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <TextBox x:Name="CodeInput" Style="{StaticResource InputTextBox}" IsReadOnly="True" Background="{StaticResource SurfaceBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CUSTOMER TYPE *" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <ComboBox x:Name="TypeInput" Style="{StaticResource AppComboBox}" SelectedIndex="0">
                                    <ComboBoxItem Content="Individual" />
                                    <ComboBoxItem Content="Business" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="FULL NAME / BUSINESS NAME *" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                        <TextBox x:Name="NameInput" Style="{StaticResource InputTextBox}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PRIMARY PHONE *" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <TextBox x:Name="PhoneInput" Style="{StaticResource InputTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ALTERNATIVE PHONE" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <TextBox x:Name="AltPhoneInput" Style="{StaticResource InputTextBox}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="EMAIL" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                        <TextBox x:Name="EmailInput" Style="{StaticResource InputTextBox}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CITY" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <TextBox x:Name="CityInput" Style="{StaticResource InputTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DATE OF BIRTH" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <DatePicker x:Name="DobInput" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="ADDRESS" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                        <TextBox x:Name="AddressInput" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="NOTES" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <Border Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBox x:Name="NotesInput" Style="{StaticResource InputTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
                        <CheckBox x:Name="ActiveInput" Content="Customer is active" IsChecked="True" Margin="0,12,0,0"
                                  Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" MinWidth="100" Margin="0,0,10,0"
                        Click="Cancel_Click" />
                <Button x:Name="SaveButton" Content="Save customer" Style="{StaticResource PrimaryButton}" MinWidth="150"
                        Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>