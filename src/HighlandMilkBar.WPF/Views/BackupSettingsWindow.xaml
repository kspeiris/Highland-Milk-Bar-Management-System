<Window x:Class="HighlandMilkBar.WPF.Views.BackupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Settings" Width="640" Height="760" MinWidth="560" MinHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Backup settings" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Configure automatic backups, destination and retention. Automatic backups only run while the application is open."
                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="AUTOMATIC BACKUP" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <Border Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox Content="Enable automatic backup" IsChecked="{Binding AutomaticBackupEnabled}"
                                  Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="FREQUENCY" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding FrequencyOptions}"
                                          SelectedItem="{Binding Frequency}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="BACKUP TIME (HH:MM)" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <TextBox Style="{StaticResource InputTextBox}" Text="{Binding BackupTime, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="DAY OF WEEK (WEEKLY)" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                        <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding WeekdayOptions}"
                                  SelectedItem="{Binding Weekday}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="BACKUP LOCATION" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <Border Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Content="Browse..." Style="{StaticResource OutlineButton}" MinWidth="100" Click="Browse_Click" />
                    </Grid>
                </Border>

                <TextBlock Text="RETENTION" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <Border Style="{StaticResource FlatCard}" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="KEEP LAST N AUTOMATIC" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <TextBox Style="{StaticResource InputTextBox}" Text="{Binding RetentionCount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MAX BACKUP AGE (DAYS)" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <TextBox Style="{StaticResource InputTextBox}" Text="{Binding MaxBackupAgeDays, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="MINIMUM VALID AUTOMATIC BACKUPS" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding MinimumValidBackups, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"
                       Margin="0,0,0,10" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" MinWidth="100" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button Content="Save settings" Style="{StaticResource PrimaryButton}" MinWidth="150" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>