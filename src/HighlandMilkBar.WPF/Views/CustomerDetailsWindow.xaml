<Window x:Class="HighlandMilkBar.WPF.Views.CustomerDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls"
        Title="Customer profile" Width="1000" Height="760" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="22" FontWeight="Bold" />
                <TextBlock x:Name="SubtitleText" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource FlatCard}" Padding="10,6" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource FlatCard}" Margin="0,14,0,0" Padding="14">
            <UniformGrid Columns="4">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="TOTAL PURCHASES" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding TotalPurchases}" FontSize="18" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="TOTAL SPENDING (LKR)" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding TotalSpending, StringFormat=N2}" FontSize="18" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="AVG PURCHASE (LKR)" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding AveragePurchaseValue, StringFormat=N2}" FontSize="18" FontWeight="Bold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="LOYALTY POINTS" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding PointsBalance}" FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <TabControl Grid.Row="2" Margin="0,14,0,0">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <Border Style="{StaticResource FlatCard}" Padding="16" Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CONTACT" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding CustomerCode, StringFormat=Code: {0}}" Margin="0,2" />
                                <TextBlock Text="{Binding TypeText, StringFormat=Type: {0}}" Margin="0,2" />
                                <TextBlock Text="{Binding Phone, StringFormat=Phone: {0}}" Margin="0,2" />
                                <TextBlock Text="{Binding AlternativePhone, StringFormat=Alt phone: {0}}" Margin="0,2" />
                                <TextBlock Text="{Binding Email, StringFormat=Email: {0}}" Margin="0,2" />
                                <TextBlock Text="{Binding Address, StringFormat=Address: {0}}" Margin="0,2" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding City, StringFormat=City: {0}}" Margin="0,2" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ACCOUNT" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding RegistrationDate, StringFormat=Registered: {0}}" Margin="0,2" />
                                <TextBlock Text="{Binding DateOfBirth, StringFormat=Date of birth: {0}}" Margin="0,2" />
                                <TextBlock Text="{Binding LastPurchase, StringFormat=Last purchase: {0}}" Margin="0,2" />
                                <TextBlock Text="{Binding TotalReturns, StringFormat=Total returns (LKR): {0:N2}}" Margin="0,2" />
                                <TextBlock Text="{Binding Notes, StringFormat=Notes: {0}}" Margin="0,2" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Purchase History">
                <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding PurchaseHistory}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="INVOICE" Binding="{Binding ReceiptNumber}" Width="160" />
                        <DataGridTextColumn Header="DATE" Binding="{Binding SoldAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150" />
                        <DataGridTextColumn Header="TOTAL (LKR)" Binding="{Binding TotalAmount, StringFormat=N2}" Width="120" />
                        <DataGridTextColumn Header="PAYMENT" Binding="{Binding PaymentMethodText}" Width="120" />
                        <DataGridTextColumn Header="STATUS" Binding="{Binding StatusText}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Purchased Products">
                <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding PurchasedProducts}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="2*" />
                        <DataGridTextColumn Header="QUANTITY" Binding="{Binding TotalQuantity, StringFormat=N3}" Width="120" />
                        <DataGridTextColumn Header="SPENT (LKR)" Binding="{Binding TotalSpent, StringFormat=N2}" Width="140" />
                        <DataGridTextColumn Header="LAST PURCHASED" Binding="{Binding LastPurchased, StringFormat=yyyy-MM-dd}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Payments &amp; Returns">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <GroupBox Header="Payments" Margin="4">
                        <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Payments}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="INVOICE" Binding="{Binding ReceiptNumber}" Width="160" />
                                <DataGridTextColumn Header="DATE" Binding="{Binding PaidAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150" />
                                <DataGridTextColumn Header="METHOD" Binding="{Binding MethodText}" Width="100" />
                                <DataGridTextColumn Header="AMOUNT (LKR)" Binding="{Binding Amount, StringFormat=N2}" Width="130" />
                                <DataGridTextColumn Header="REFERENCE" Binding="{Binding Reference}" Width="1*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GroupBox Header="Returns" Grid.Row="1" Margin="4">
                        <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Returns}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="RETURN" Binding="{Binding ReturnNumber}" Width="160" />
                                <DataGridTextColumn Header="INVOICE" Binding="{Binding ReceiptNumber}" Width="160" />
                                <DataGridTextColumn Header="DATE" Binding="{Binding ReturnedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150" />
                                <DataGridTextColumn Header="AMOUNT (LKR)" Binding="{Binding TotalAmount, StringFormat=N2}" Width="130" />
                                <DataGridTextColumn Header="STATUS" Binding="{Binding StatusText}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Loyalty">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource FlatCard}" Padding="14" Margin="4">
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="BALANCE" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding PointsBalance}" FontSize="18" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="EARNED" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding PointsEarned}" FontSize="18" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="REVERSED" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding PointsReversed}" FontSize="18" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="REDEEMED" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding PointsRedeemed}" FontSize="18" FontWeight="Bold" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                    <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding LoyaltyHistory}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding TransactionDate, StringFormat=yyyy-MM-dd HH:mm}" Width="150" />
                            <DataGridTextColumn Header="TYPE" Binding="{Binding TypeText}" Width="110" />
                            <DataGridTextColumn Header="POINTS" Binding="{Binding Points}" Width="90" />
                            <DataGridTextColumn Header="BALANCE" Binding="{Binding BalanceAfter}" Width="90" />
                            <DataGridTextColumn Header="REFERENCE" Binding="{Binding Reference}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>