<UserControl x:Class="HighlandMilkBar.WPF.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls"
             Loaded="MenuView_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource FlatCard}" Padding="14">
            <StackPanel Orientation="Horizontal">
                <Border Width="240" Margin="0,0,10,0">
                    <controls:SearchBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
                <ComboBox Style="{StaticResource AppComboBox}" MinWidth="180" Margin="0,0,10,0"
                          ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedCategory}" ToolTip="Filter by category" />
                <Button Content="Search" Style="{StaticResource PrimaryButton}" MinWidth="90"
                        Command="{Binding SearchCommand}" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,14,10,10">
            <TextBlock Text="{Binding ResultCount, StringFormat={}{0} menu items}" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="View recipe" Style="{StaticResource SecondaryButton}" MinWidth="110" Margin="0,0,8,0"
                        Command="{Binding ViewRecipeCommand}" />
                <Button Content="Pricing calculator" Style="{StaticResource OutlineButton}" MinWidth="140"
                        Command="{Binding ViewPricingCommand}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
            <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MENU ITEM" Binding="{Binding Name}" Width="1.6*" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" />
                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding CategoryName}" Width="130" />
                    <DataGridTextColumn Header="PRICE" Binding="{Binding SellingPrice, StringFormat=LKR {0:N2}}" Width="100" />
                    <DataGridTextColumn Header="RECIPE" Binding="{Binding RecipeStatus}" Width="110" />
                    <DataGridTextColumn Header="EST. COST" Binding="{Binding EstimatedCost, StringFormat={}{0:N2}}" Width="100" />
                    <DataGridTextColumn Header="EST. PROFIT" Binding="{Binding EstimatedProfit, StringFormat={}{0:N2}}" Width="100" />
                    <DataGridTextColumn Header="MARGIN" Binding="{Binding EstimatedMarginPercent, StringFormat={}{0:N1}%}" Width="90" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding StatusText}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>