<UserControl x:Class="HighlandMilkBar.WPF.Views.StockAdjustmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="APPLY A STOCK ADJUSTMENT" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
            <Border Style="{StaticResource FlatCard}" Padding="18">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PRODUCT *" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding Products}"
                                      DisplayMemberPath="Name" SelectedItem="{Binding SelectedProduct}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="BATCH (OPTIONAL)" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding Batches}"
                                      DisplayMemberPath="BatchNumber" SelectedItem="{Binding SelectedBatch}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ADJUSTMENT TYPE *" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding KindOptions}"
                                      DisplayMemberPath="Label" SelectedItem="{Binding SelectedKind}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="QUANTITY CHANGE *" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="UNIT COST (LKR)" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding UnitCostText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="REFERENCE NO." Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="NOTE" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Refresh products" Style="{StaticResource SecondaryButton}" MinWidth="140"
                                Margin="0,0,10,0" Command="{Binding RefreshProductsCommand}" />
                        <Button Content="Apply adjustment" Style="{StaticResource PrimaryButton}" MinWidth="160"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>