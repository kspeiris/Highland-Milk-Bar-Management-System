<Window x:Class="HighlandMilkBar.WPF.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt" Width="440" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource FlatCard}" Padding="12">
            <TextBox x:Name="ReceiptText" IsReadOnly="True" Background="White"
                     FontFamily="Courier New" FontSize="12"
                     BorderThickness="0" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Print" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="0,0,8,0"
                    Click="Print_Click" />
            <Button Content="Save PDF" Style="{StaticResource SecondaryButton}" MinWidth="100" Margin="0,0,8,0"
                    Click="SavePdf_Click" />
            <Button Content="Close" Style="{StaticResource OutlineButton}" MinWidth="90" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>