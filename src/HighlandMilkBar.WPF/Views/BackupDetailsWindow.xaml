<Window x:Class="HighlandMilkBar.WPF.Views.BackupDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Details" Width="580" Height="620" MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Backup verification" FontSize="22" FontWeight="Bold" />
            <TextBlock x:Name="SubtitleText" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="OverallText" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                <Border Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,14">
                    <TextBlock x:Name="ChecksText" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" />
                </Border>
                <TextBlock x:Name="MessagesHeader" Text="DETAILS" Style="{StaticResource LabelText}" Margin="0,0,0,8" Visibility="Collapsed" />
                <Border x:Name="MessagesCard" Style="{StaticResource FlatCard}" Padding="16" Visibility="Collapsed">
                    <TextBlock x:Name="MessagesText" TextWrapping="Wrap" FontSize="12" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Close" Style="{StaticResource OutlineButton}" MinWidth="100"
                HorizontalAlignment="Right" Margin="0,16,0,0" Click="Close_Click" />
    </Grid>
</Window>