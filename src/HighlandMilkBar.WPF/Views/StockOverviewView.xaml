<UserControl x:Class="HighlandMilkBar.WPF.Views.StockOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filters -->
        <Border Grid.Row="0" Style="{StaticResource FlatCard}" Padding="14">
            <StackPanel Orientation="Horizontal">
                <Border Width="240" Margin="0,0,10,0">
                    <controls:SearchBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
                <ComboBox Style="{StaticResource AppComboBox}" MinWidth="170" Margin="0,0,10,0"
                          ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedCategory}" ToolTip="Filter by category" />
                <ComboBox Style="{StaticResource AppComboBox}" MinWidth="150" Margin="0,0,10,0"
                          ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedStatus}" ToolTip="Filter by stock status" />
                <Button Content="Search" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="0,0,8,0"
                        Command="{Binding SearchCommand}" />
                <Button Content="Clear" Style="{StaticResource OutlineButton}" MinWidth="80"
                        Command="{Binding ClearFiltersCommand}" />
            </StackPanel>
        </Border>

        <!-- Paging -->
        <Grid Grid.Row="1" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="‹" Style="{StaticResource IconButton}" Command="{Binding PreviousPageCommand}" ToolTip="Previous page" />
                <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="8,0" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Button Content="›" Style="{StaticResource IconButton}" Command="{Binding NextPageCommand}" ToolTip="Next page" />
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- Grid -->
        <Border Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
            <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" />
                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding CategoryName}" Width="1.3*" />
                    <DataGridTextColumn Header="PHYSICAL" Binding="{Binding PhysicalStock, StringFormat={}{0:N3}}" Width="95" />
                    <DataGridTextColumn Header="SELLABLE" Binding="{Binding SellableStock, StringFormat={}{0:N3}}" Width="95" />
                    <DataGridTextColumn Header="EXPIRED" Binding="{Binding ExpiredStock, StringFormat={}{0:N3}}" Width="90" />
                    <DataGridTextColumn Header="REORDER" Binding="{Binding ReorderLevel, StringFormat={}{0:N3}}" Width="90" />
                    <DataGridTextColumn Header="SHORTFALL" Binding="{Binding Shortfall, StringFormat={}{0:N3}}" Width="90" />
                    <DataGridTemplateColumn Header="STATUS" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="LowStock">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="OutOfStock">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>