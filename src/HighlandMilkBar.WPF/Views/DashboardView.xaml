<UserControl x:Class="HighlandMilkBar.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls"
             Loaded="DashboardView_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <controls:PageHeader Title="Dashboard"
                                 Subtitle="{Binding Greeting, StringFormat='{}{0} — here is how the business is performing.'}">
                <controls:PageHeader.HeaderContent>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Style="{StaticResource AppComboBox}" MinWidth="140" Margin="0,0,8,0"
                                  ItemsSource="{Binding PeriodOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedPreset}" ToolTip="Reporting period" />
                        <Button Content="Refresh" Style="{StaticResource SecondaryButton}" MinWidth="100"
                                Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </controls:PageHeader.HeaderContent>
            </controls:PageHeader>

            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left" Text="{Binding PeriodLabel}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding LastUpdatedText}" FontSize="12"
                           HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </DockPanel>

            <Border Margin="0,8,0,0" Padding="12,8" CornerRadius="9" Background="{StaticResource DangerBrush}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Error}" Foreground="White" TextWrapping="Wrap" FontSize="12" />
            </Border>

            <!-- KPI cards: sales -->
            <UniformGrid Columns="4" Margin="0,14,0,0">
                <controls:StatCard Title="NET SALES (LKR)" Value="{Binding NetSales, StringFormat=N0}"
                                   Caption="{Binding NetSalesChange}" Glyph="&#xE8C8;" Accent="{StaticResource PrimaryBrush}" Margin="0,0,12,0" />
                <controls:StatCard Title="GROSS PROFIT (LKR)" Value="{Binding GrossProfit, StringFormat=N0}"
                                   Caption="{Binding GrossProfitChange}" Glyph="&#xE9D9;" Accent="{StaticResource SuccessBrush}" Margin="0,0,12,0" />
                <controls:StatCard Title="ORDERS" Value="{Binding Orders}"
                                   Caption="{Binding OrdersChange}" Glyph="&#xE8A5;" Accent="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                <controls:StatCard Title="AVG. ORDER VALUE (LKR)" Value="{Binding AverageOrderValue, StringFormat=N0}"
                                   Caption="Net sales ÷ orders" Glyph="&#xE8C8;" Accent="{StaticResource PrimaryBrush}" />
            </UniformGrid>

            <!-- KPI cards: customers, expenses, inventory -->
            <UniformGrid Columns="4" Margin="0,12,0,0">
                <controls:StatCard Title="CUSTOMERS" Value="{Binding TotalCustomers}"
                                   Caption="{Binding NewCustomers, StringFormat={}{0} new this month}" Glyph="&#xE7EE;" Accent="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                <controls:StatCard Title="OPERATING EXPENSES (LKR)" Value="{Binding Expenses, StringFormat=N0}"
                                   Caption="{Binding ExpensesChange}" Glyph="&#xE8C8;" Accent="{StaticResource DangerBrush}" Margin="0,0,12,0" />
                <controls:StatCard Title="SELLABLE INVENTORY (LKR)" Value="{Binding SellableStockValue, StringFormat=N0}"
                                   Caption="{Binding PhysicalStockValue, StringFormat='Physical LKR {0:N0}'}" Glyph="&#xE8EC;" Accent="{StaticResource SuccessBrush}" Margin="0,0,12,0" />
                <controls:StatCard Title="LOW STOCK / EXPIRED" Value="{Binding LowStockProducts}"
                                   Caption="{Binding ExpiredBatches, StringFormat={}{0} expired batches}" Glyph="&#xE823;" Accent="{StaticResource DangerBrush}" />
            </UniformGrid>

            <!-- Sales trend -->
            <Border Style="{StaticResource AppCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Sales performance trend" Style="{StaticResource CardHeadingText}" />
                    <TextBlock Text="{Binding PeriodLabel, StringFormat='{}{0} (net sales)'}" Style="{StaticResource SecondaryText}" Margin="0,3,0,10" />
                    <ItemsControl ItemsSource="{Binding Trend}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ProgressBar Grid.Column="1" Height="10" Minimum="0"
                                                 Maximum="{Binding DataContext.TrendMax, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                 Value="{Binding NetSales}" Margin="0,0,10,0"
                                                 Foreground="{StaticResource PrimaryBrush}" Background="{StaticResource PrimaryLightBrush}" BorderThickness="0" />
                                    <TextBlock Grid.Column="2" Text="{Binding NetSales, StringFormat=N2}" FontSize="12"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Top products + category sales -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AppCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Top-selling products" Style="{StaticResource CardHeadingText}" />
                        <TextBlock Text="By units sold this period" Style="{StaticResource SecondaryText}" Margin="0,3,0,10" />
                        <ItemsControl ItemsSource="{Binding TopProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding UnitsSold, StringFormat='{}{0:N0} u'}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{Binding Revenue, StringFormat=N0}" FontSize="12"
                                                   FontWeight="SemiBold" TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource AppCard}">
                    <StackPanel>
                        <TextBlock Text="Sales by category" Style="{StaticResource CardHeadingText}" />
                        <TextBlock Text="Share of revenue" Style="{StaticResource SecondaryText}" Margin="0,3,0,10" />
                        <ItemsControl ItemsSource="{Binding CategorySales}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CategoryName}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="{Binding Percentage}"
                                                     Margin="0,0,10,0" Foreground="{StaticResource PrimaryBrush}"
                                                     Background="{StaticResource PrimaryLightBrush}" BorderThickness="0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Percentage, StringFormat={}{0:N0}%}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Inventory + customer insights -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource AppCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Inventory insights" Style="{StaticResource CardHeadingText}" />
                        <TextBlock Text="Current stock snapshot" Style="{StaticResource SecondaryText}" Margin="0,3,0,10" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Physical value" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding PhysicalStockValue, StringFormat=N2}" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Sellable value" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding SellableStockValue, StringFormat=N2}" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Low stock" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding LowStockProducts}" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Expired batches" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ExpiredBatches}" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource AppCard}">
                    <StackPanel>
                        <TextBlock Text="Customer insights" Style="{StaticResource CardHeadingText}" />
                        <TextBlock Text="Registered customers" Style="{StaticResource SecondaryText}" Margin="0,3,0,10" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Total" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding TotalCustomers}" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="New" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding NewCustomers}" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Repeat" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding RepeatCustomers}" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Business alerts -->
            <Border Style="{StaticResource AppCard}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Business alerts" Style="{StaticResource CardHeadingText}" />
                            <TextBlock Text="Rule-based, from actual records" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Content="Open analytics" Style="{StaticResource GhostButton}"
                                Command="{Binding NavigateToAnalyticsCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Alerts}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12,9" CornerRadius="9" Background="{StaticResource BackgroundBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="6" CornerRadius="3" Margin="0,0,12,0" VerticalAlignment="Stretch">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                            <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding SuggestedAction}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource PrimaryBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="Financial figures come from the Finance module; inventory is a current snapshot."
                       Style="{StaticResource SecondaryText}" Margin="0,14,0,4" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>