<UserControl x:Class="HighlandMilkBar.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- Page header -->
            <controls:PageHeader Title="Dashboard"
                                 Subtitle="{Binding Greeting, StringFormat='{}{0} — here is what is happening at your outlet today.'}">
                <controls:PageHeader.HeaderContent>
                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="9" Padding="13,9">
                        <TextBlock Text="{Binding TodayText}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                    </Border>
                </controls:PageHeader.HeaderContent>
            </controls:PageHeader>

            <!-- KPI cards -->
            <UniformGrid Columns="4" Margin="0,20,0,0">
                <controls:StatCard Title="TODAY'S REVENUE"
                                   Value="{Binding RevenueTodayText}"
                                   Caption="Completed sales today"
                                   Glyph="LKR"
                                   Accent="{StaticResource PrimaryBrush}"
                                   Margin="0,0,12,0" />
                <controls:StatCard Title="TODAY'S PROFIT"
                                   Value="{Binding ProfitTodayText}"
                                   Caption="Estimated gross profit"
                                   Glyph="↗"
                                   IsDemo="True"
                                   Accent="{StaticResource SuccessBrush}"
                                   Margin="0,0,12,0" />
                <controls:StatCard Title="TRANSACTIONS"
                                   Value="{Binding TransactionsToday}"
                                   Caption="Completed receipts today"
                                   Glyph="▤"
                                   Accent="{StaticResource AccentBrush}"
                                   Margin="0,0,12,0" />
                <controls:StatCard Title="TODAY'S EXPENSES"
                                   Value="{Binding ExpensesTodayText}"
                                   Caption="Recorded operating costs"
                                   Glyph="◈"
                                   IsDemo="True"
                                   Accent="{StaticResource WarningBrush}" />
            </UniformGrid>

            <!-- Analytics -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AppCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Sales trend" Style="{StaticResource CardHeadingText}" />
                                <TextBlock Text="Last 7 days" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Style="{StaticResource StatusBadgeWarning}" HorizontalAlignment="Right">
                                <TextBlock Text="DEMO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource InsetPanel}" Margin="0,14,0,0" Height="190">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Width="26" VerticalAlignment="Bottom" Fill="{StaticResource PrimaryBrush}" Opacity="0.35" />
                                <Rectangle Grid.Column="1" Width="26" VerticalAlignment="Bottom" Fill="{StaticResource PrimaryBrush}" Opacity="0.45" />
                                <Rectangle Grid.Column="2" Width="26" VerticalAlignment="Bottom" Fill="{StaticResource PrimaryBrush}" Opacity="0.55" />
                                <Rectangle Grid.Column="3" Width="26" VerticalAlignment="Bottom" Fill="{StaticResource PrimaryBrush}" Opacity="0.75" />
                                <Rectangle Grid.Column="4" Width="26" VerticalAlignment="Bottom" Fill="{StaticResource PrimaryBrush}" Opacity="0.65" />
                                <Rectangle Grid.Column="5" Width="26" VerticalAlignment="Bottom" Fill="{StaticResource PrimaryBrush}" Opacity="0.9" />
                                <Rectangle Grid.Column="6" Width="26" VerticalAlignment="Bottom" Fill="{StaticResource PrimaryBrush}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="A real sales trend will replace this preview once transactions are recorded."
                                   Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource AppCard}">
                    <StackPanel>
                        <TextBlock Text="Sales by category" Style="{StaticResource CardHeadingText}" />
                        <TextBlock Text="Demo distribution" Style="{StaticResource SecondaryText}" Margin="0,3,0,12" />
                        <ItemsControl ItemsSource="{Binding CategorySales}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Category}" FontSize="12" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="100"
                                                     Value="{Binding Percent}" Margin="0,0,10,0"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Background="{StaticResource PrimaryLightBrush}"
                                                     BorderThickness="0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Amount}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Top products + inventory alerts -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AppCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Top-selling products" Style="{StaticResource CardHeadingText}" />
                        <TextBlock Text="Demo data" Style="{StaticResource SecondaryText}" Margin="0,3,0,12" />
                        <ItemsControl ItemsSource="{Binding TopProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Units, StringFormat='{}{0} units'}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{Binding Amount}" FontSize="12"
                                                   FontWeight="SemiBold" TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource AppCard}">
                    <StackPanel>
                        <TextBlock Text="Inventory alerts" Style="{StaticResource CardHeadingText}" />
                        <TextBlock Text="Demo data" Style="{StaticResource SecondaryText}" Margin="0,3,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Style="{StaticResource StatusBadgeWarning}">
                                <TextBlock Text="LOW STOCK" FontSize="9" FontWeight="Bold" Foreground="#9A6518" />
                            </Border>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding LowStockAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Product}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                            <Border Style="{StaticResource StatusBadgeWarning}">
                                <TextBlock Text="NEAR EXPIRY" FontSize="9" FontWeight="Bold" Foreground="#9A6518" />
                            </Border>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding NearExpiryAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Product}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                            <Border Style="{StaticResource StatusBadgeDanger}">
                                <TextBlock Text="EXPIRED" FontSize="9" FontWeight="Bold" Foreground="#B23A3A" />
                            </Border>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ExpiredAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Product}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent transactions -->
            <Border Style="{StaticResource AppCard}" Margin="0,18,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Recent transactions" Style="{StaticResource CardHeadingText}" />
                            <TextBlock Text="Most recent receipts" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource StatusBadgeWarning}" HorizontalAlignment="Right">
                            <TextBlock Text="DEMO DATA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                        </Border>
                    </Grid>
                    <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding RecentSales}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="INVOICE" Binding="{Binding Invoice}" Width="120" />
                            <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="170" />
                            <DataGridTextColumn Header="ITEMS" Binding="{Binding Items}" Width="80" />
                            <DataGridTextColumn Header="PAYMENT" Binding="{Binding Payment}" Width="110" />
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding Total}" Width="140" />
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding DemoNote}" Style="{StaticResource SecondaryText}"
                       Margin="0,14,0,4" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>