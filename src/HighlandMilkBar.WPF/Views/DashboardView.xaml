<UserControl x:Class="HighlandMilkBar.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="Here is what's happening at your outlet today." FontSize="12" Foreground="#77869A" Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#EAF3FB" CornerRadius="9" Padding="13,9" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TodayText}" FontSize="11.5" Foreground="#15558A" FontWeight="SemiBold" />
                </Border>
            </Grid>

            <!-- KPI cards -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,12,0" BorderBrush="#E8EDF3" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="TODAY'S REVENUE" FontSize="10" FontWeight="Bold" Foreground="#77869A" />
                            <Border Background="#EAF3FB" CornerRadius="9" Width="34" Height="34" HorizontalAlignment="Right">
                                <TextBlock Text="LKR" FontSize="9" FontWeight="Bold" Foreground="#1769AA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding RevenueTodayText}" FontSize="23" FontWeight="Bold" Margin="0,15,0,3" />
                        <TextBlock Text="Completed sales today" FontSize="10.5" Foreground="#8A98A9" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,12,0" BorderBrush="#E8EDF3" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="TRANSACTIONS" FontSize="10" FontWeight="Bold" Foreground="#77869A" />
                            <Border Background="#E9F7F0" CornerRadius="9" Width="34" Height="34" HorizontalAlignment="Right">
                                <TextBlock Text="↗" FontSize="18" FontWeight="Bold" Foreground="#16865B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding TransactionsToday}" FontSize="27" FontWeight="Bold" Margin="0,15,0,3" />
                        <TextBlock Text="Completed receipts today" FontSize="10.5" Foreground="#8A98A9" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,12,0" BorderBrush="#E8EDF3" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="ACTIVE PRODUCTS" FontSize="10" FontWeight="Bold" Foreground="#77869A" />
                            <Border Background="#F1EDFC" CornerRadius="9" Width="34" Height="34" HorizontalAlignment="Right">
                                <TextBlock Text="▤" FontSize="17" Foreground="#7755B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding ActiveProducts}" FontSize="27" FontWeight="Bold" Margin="0,15,0,3" />
                        <TextBlock Text="Products available in catalogue" FontSize="10.5" Foreground="#8A98A9" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="14" Padding="18" BorderBrush="#E8EDF3" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="LOW STOCK ITEMS" FontSize="10" FontWeight="Bold" Foreground="#77869A" />
                            <Border Background="#FFF4E5" CornerRadius="9" Width="34" Height="34" HorizontalAlignment="Right">
                                <TextBlock Text="!" FontSize="19" FontWeight="Bold" Foreground="#B7791F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding LowStockItems}" FontSize="27" FontWeight="Bold" Margin="0,15,0,3" />
                        <TextBlock Text="At or below reorder level" FontSize="10.5" Foreground="#8A98A9" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="20" Margin="0,0,12,0" BorderBrush="#E8EDF3" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Sales overview" FontSize="15" FontWeight="Bold" />
                                <TextBlock Text="A visual summary will appear when sales are recorded." FontSize="10.5" Foreground="#8A98A9" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="LIVE DATA" FontSize="9" FontWeight="Bold" Foreground="#16865B" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Background="#F7F9FC" CornerRadius="10" Padding="18" Margin="0,18,0,0" MinHeight="180">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="46" Height="46" CornerRadius="23" Background="#EAF3FB" HorizontalAlignment="Center">
                                    <TextBlock Text="⌁" FontSize="27" Foreground="#1769AA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Your sales journey starts here" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,11,0,3" />
                                <TextBlock Text="Once you start recording transactions, this area will show your sales trend." FontSize="10.5" Foreground="#8593A4" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="370" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20" BorderBrush="#E8EDF3" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Quick actions" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="Jump into your daily tasks." FontSize="10.5" Foreground="#8A98A9" Margin="0,4,0,14" />
                        <Button Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Left" Command="{Binding NavigateToPosCommand}" Margin="0,0,0,9">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="17" Margin="0,0,10,0" /><TextBlock Text="Start a sale" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Command="{Binding NavigateToProductsCommand}" Margin="0,0,0,9">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="16" Margin="0,0,10,0" /><TextBlock Text="Manage products" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Command="{Binding NavigateToInventoryCommand}" Margin="0,0,0,9">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="▥" FontSize="16" Margin="0,0,10,0" /><TextBlock Text="Check inventory" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Command="{Binding NavigateToReportsCommand}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="▧" FontSize="16" Margin="0,0,10,0" /><TextBlock Text="View reports" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="White" CornerRadius="14" Padding="20" BorderBrush="#E8EDF3" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Getting started" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="Complete these setup tasks before using the outlet for live transactions." FontSize="10.5" Foreground="#8A98A9" Margin="0,4,0,14" />
                        <WrapPanel>
                            <Border Background="#F4F7FB" CornerRadius="8" Padding="11,8" Margin="0,0,8,0"><TextBlock Text="1  Add your products" FontSize="10.5" /></Border>
                            <Border Background="#F4F7FB" CornerRadius="8" Padding="11,8" Margin="0,0,8,0"><TextBlock Text="2  Enter actual prices" FontSize="10.5" /></Border>
                            <Border Background="#F4F7FB" CornerRadius="8" Padding="11,8" Margin="0,0,8,0"><TextBlock Text="3  Record opening stock" FontSize="10.5" /></Border>
                            <Border Background="#F4F7FB" CornerRadius="8" Padding="11,8"><TextBlock Text="4  Configure receipts" FontSize="10.5" /></Border>
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding LastUpdatedText}" FontSize="10" Foreground="#9AA6B2" VerticalAlignment="Top" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
