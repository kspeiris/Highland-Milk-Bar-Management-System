<UserControl x:Class="HighlandMilkBar.WPF.Views.ExpiryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" FontSize="12" Margin="0,0,0,10"
                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

        <!-- Near expiry -->
        <Border Grid.Row="1" Style="{StaticResource AppCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="NEAR EXPIRY (30 DAYS)" Style="{StaticResource LabelText}" />
                    <Border Style="{StaticResource StatusBadgeWarning}" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NearExpiryCount}" FontSize="11" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding NearExpiry}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="1.6*" />
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" />
                        <DataGridTextColumn Header="BATCH" Binding="{Binding BatchNumber}" Width="120" />
                        <DataGridTextColumn Header="EXPIRY" Binding="{Binding ExpiryDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100" />
                        <DataGridTextColumn Header="QTY" Binding="{Binding QuantityRemaining, StringFormat={}{0:N3}}" Width="90" />
                        <DataGridTextColumn Header="VALUE" Binding="{Binding Value, StringFormat={}{0:N2}}" Width="95" />
                        <DataGridTextColumn Header="DAYS LEFT" Binding="{Binding DaysRemaining}" Width="80" />
                        <DataGridTextColumn Header="STATUS" Binding="{Binding ExpiryStatus}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Expired -->
        <Border Grid.Row="3" Style="{StaticResource AppCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="EXPIRED BATCHES" Style="{StaticResource LabelText}" />
                    <Border Style="{StaticResource StatusBadgeDanger}" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ExpiredCount}" FontSize="11" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Expired}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="1.6*" />
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" />
                        <DataGridTextColumn Header="BATCH" Binding="{Binding BatchNumber}" Width="120" />
                        <DataGridTextColumn Header="EXPIRY" Binding="{Binding ExpiryDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100" />
                        <DataGridTextColumn Header="QTY" Binding="{Binding QuantityRemaining, StringFormat={}{0:N3}}" Width="90" />
                        <DataGridTextColumn Header="VALUE" Binding="{Binding Value, StringFormat={}{0:N2}}" Width="95" />
                        <DataGridTextColumn Header="DAYS LEFT" Binding="{Binding DaysRemaining}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>