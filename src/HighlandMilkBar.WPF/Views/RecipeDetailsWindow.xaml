<Window x:Class="HighlandMilkBar.WPF.Views.RecipeDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recipe details" Width="900" Height="760"
        xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                    <Run Text="{Binding MenuProductName}" /><Run Text="  •  " /><Run Text="{Binding CategoryName}" /><Run Text="  •  " /><Run Text="{Binding YieldText}" /><Run Text="  •  " /><Run Text="{Binding StatusText}" />
                </TextBlock>
            </StackPanel>

            <!-- Cost summary -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,6">
                <Border Margin="0,0,6,6"><controls:StatCard Title="Total cost" Value="{Binding TotalCost, StringFormat=N2}" Glyph="◈" /></Border>
                <Border Margin="0,0,6,6"><controls:StatCard Title="Cost / serving" Value="{Binding CostPerServing, StringFormat=N2}" Glyph="◐" /></Border>
                <Border Margin="6,0,0,6"><controls:StatCard Title="Selling price" Value="{Binding SellingPrice, StringFormat=N2}" Glyph="＄" /></Border>
                <Border Margin="6,0,0,6"><controls:StatCard Title="Margin" Value="{Binding MarginPercent, StringFormat=N1}" Glyph="%" /></Border>
            </UniformGrid>

            <!-- Cost breakdown -->
            <Border Grid.Row="2" Style="{StaticResource AppCard}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="COST BREAKDOWN" Style="{StaticResource LabelText}" Margin="0,0,0,10" />
                    <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding CostLines}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="INGREDIENT" Binding="{Binding IngredientName}" Width="2*" />
                            <DataGridTextColumn Header="QTY" Binding="{Binding Quantity, StringFormat={}{0:N3}}" Width="90" />
                            <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="70" />
                            <DataGridTextColumn Header="UNIT COST" Binding="{Binding UnitCost, StringFormat={}{0:N4}}" Width="100" />
                            <DataGridTextColumn Header="LINE COST" Binding="{Binding LineCost, StringFormat={}{0:N2}}" Width="100" />
                            <DataGridTextColumn Header="SHARE" Binding="{Binding SharePercent, StringFormat={}{0:N1}%}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Availability -->
            <Border Grid.Row="3" Style="{StaticResource AppCard}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource LabelText}" Margin="0,0,0,10">
                        INGREDIENT AVAILABILITY  —  max servings: <Run Text="{Binding MaxServingsText}" FontWeight="Bold" />
                    </TextBlock>
                    <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Availability}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="INGREDIENT" Binding="{Binding IngredientName}" Width="2*" />
                            <DataGridTextColumn Header="REQ / SERVING" Binding="{Binding RequiredPerServing, StringFormat={}{0:N3}}" Width="110" />
                            <DataGridTextColumn Header="AVAILABLE" Binding="{Binding AvailableStock, StringFormat={}{0:N3}}" Width="100" />
                            <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="70" />
                            <DataGridTextColumn Header="SHORTAGE" Binding="{Binding Shortage, StringFormat={}{0:N3}}" Width="90" />
                            <DataGridTemplateColumn Header="STATUS" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:StatusBadge Text="{Binding StatusText}">
                                            <controls:StatusBadge.Style>
                                                <Style TargetType="controls:StatusBadge">
                                                    <Setter Property="BadgeBackground" Value="{StaticResource SuccessSurfaceBrush}" />
                                                    <Setter Property="BadgeForeground" Value="{StaticResource SuccessBadgeTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                            <Setter Property="BadgeBackground" Value="{StaticResource DangerSurfaceBrush}" />
                                                            <Setter Property="BadgeForeground" Value="{StaticResource DangerBadgeTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:StatusBadge.Style>
                                        </controls:StatusBadge>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Pricing calculator -->
            <Border Grid.Row="4" Style="{StaticResource AppCard}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="PRICING CALCULATOR" Style="{StaticResource LabelText}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Target margin %" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="80" Style="{StaticResource InputTextBox}" Text="{Binding TargetMarginText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Rounding (LKR)" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <TextBox Width="80" Style="{StaticResource InputTextBox}" Text="{Binding RoundingText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Calculate" Style="{StaticResource SecondaryButton}" MinWidth="100" Margin="16,0,0,0"
                                Command="{Binding CalculatePricingCommand}" />
                    </StackPanel>

                    <Grid DataContext="{Binding Pricing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock><Run Text="Recommended price: " /><Run Text="{Binding RecommendedPriceRounded, StringFormat=LKR {0:N2}}" FontWeight="Bold" /></TextBlock>
                            <TextBlock Margin="0,4,0,0"><Run Text="Current price: " /><Run Text="{Binding CurrentSellingPrice, StringFormat=LKR {0:N2}}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock><Run Text="Current margin: " /><Run Text="{Binding CurrentMarginPercent, StringFormat={}{0:N1}%}" /></TextBlock>
                            <TextBlock Margin="0,4,0,0"><Run Text="Est. profit at recommended: " /><Run Text="{Binding RecommendedProfit, StringFormat=LKR {0:N2}}" /></TextBlock>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding RecommendationText}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Apply recommended price" Style="{StaticResource PrimaryButton}" MinWidth="200" Click="Apply_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </Grid>
    </ScrollViewer>
</Window>
