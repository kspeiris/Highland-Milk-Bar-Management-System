<UserControl x:Class="HighlandMilkBar.WPF.Views.StockInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="RECORD A STOCK RECEIPT" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
            <Border Style="{StaticResource FlatCard}" Padding="18">
                <StackPanel>
                    <TextBlock Text="PRODUCT *" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                    <ComboBox Style="{StaticResource AppComboBox}" Margin="0,0,0,12"
                              ItemsSource="{Binding Products}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedProduct}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="BATCH NUMBER *" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RECEIVED DATE" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <DatePicker SelectedDate="{Binding ReceivedDate}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="EXPIRY DATE" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <DatePicker SelectedDate="{Binding ExpiryDate}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,8" FontSize="11.5"
                                   Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding ProductRequiresExpiry, Converter={StaticResource BoolToVis}}"
                                   Text="This product requires an expiry date." />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="QUANTITY *" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="UNIT" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <TextBox Style="{StaticResource ReadOnlyTextBox}" Text="{Binding ProductUnit, Mode=OneWay}" IsReadOnly="True" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="UNIT COST (LKR) *" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding UnitCostText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RECEIPT REASON" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding ReasonOptions}"
                                      DisplayMemberPath="Label" SelectedItem="{Binding SelectedReason}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="REFERENCE NO." Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="NOTE" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Refresh products" Style="{StaticResource SecondaryButton}" MinWidth="140"
                                Margin="0,0,10,0" Command="{Binding RefreshProductsCommand}" />
                        <Button Content="Receive stock" Style="{StaticResource PrimaryButton}" MinWidth="150"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>