<Window x:Class="HighlandMilkBar.WPF.Views.PurchaseEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HighlandMilkBar.WPF.ViewModels"
        Title="Purchase" Width="1100" Height="820" MinWidth="920" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PurchaseEditorViewModel}" />
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeaderTitle" Text="{Binding Title}" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Record a supplier invoice and receive the goods into inventory."
                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Header fields -->
        <Border Grid.Row="1" Style="{StaticResource FlatCard}" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SUPPLIER *" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                    <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding Suppliers}"
                              DisplayMemberPath="Name" SelectedValuePath="Id" SelectedItem="{Binding SelectedSupplier}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="SUPPLIER INVOICE" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="PURCHASE DATE" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding PurchaseDateText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="DUE DATE" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding DueDateText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lines + totals -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="12,12,12,8">
                        <Button Content="＋ Add line" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="0,0,8,0"
                                Command="{Binding AddLineCommand}" />
                        <Button Content="Remove line" Style="{StaticResource OutlineButton}" MinWidth="110"
                                Command="{Binding RemoveLineCommand}" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Lines}"
                              SelectedItem="{Binding SelectedLine, Mode=TwoWay}" AutoGenerateColumns="False"
                              CanUserAddRows="False" Margin="0,0,0,0">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="PRODUCT" Width="1.6*" SelectedItemBinding="{Binding ProductId}">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        <Setter Property="DisplayMemberPath" Value="Name" />
                                        <Setter Property="SelectedValuePath" Value="Id" />
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        <Setter Property="DisplayMemberPath" Value="Name" />
                                        <Setter Property="SelectedValuePath" Value="Id" />
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="QTY" Width="80" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="UNIT" Width="80" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="COST" Width="90" Binding="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="DISC" Width="80" Binding="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="LINE TOTAL" Width="100" IsReadOnly="True" Binding="{Binding LineTotal, StringFormat=N2}" />
                            <DataGridTextColumn Header="BATCH" Width="120" Binding="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="EXPIRY" Width="110" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource AppCard}" Padding="18">
                <StackPanel>
                    <TextBlock Text="FINANCIAL SUMMARY" Style="{StaticResource LabelText}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Subtotal" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat=N2}" FontSize="12.5" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="1" Text="Purchase discount" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InputTextBox}" Width="110" Margin="0,8,0,0"
                                 Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" Text="Additional charges" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource InputTextBox}" Width="110" Margin="0,8,0,0"
                                 Text="{Binding AdditionalCharges, UpdateSourceTrigger=PropertyChanged}" />
                        <Border Grid.Row="4" Grid.ColumnSpan="2" Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,12" />
                        <TextBlock Grid.Row="5" Text="GRAND TOTAL (LKR)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding GrandTotal, StringFormat=N2}" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Right" Foreground="{StaticResource PrimaryBrush}" />
                    </Grid>

                    <TextBlock Text="NOTES" Style="{StaticResource LabelText}" Margin="0,16,0,5" />
                    <TextBox Style="{StaticResource InputTextBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,10"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" MinWidth="90" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button Content="Save as draft" Style="{StaticResource SecondaryButton}" MinWidth="130" Margin="0,0,10,0"
                        Command="{Binding SaveDraftCommand}" />
                <Button Content="Save &amp; receive" Style="{StaticResource PrimaryButton}" MinWidth="150"
                        Command="{Binding ReceiveCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>