<UserControl x:Class="HighlandMilkBar.WPF.Views.InventoryOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- Headline KPIs -->
            <UniformGrid Columns="4" Margin="0,0,0,0">
                <controls:StatCard Title="TRACKED PRODUCTS" Value="{Binding Overview.TrackedProducts}"
                                   Caption="Inventory-tracked items" Glyph="▤"
                                   Accent="{StaticResource PrimaryBrush}" Margin="0,0,12,0" />
                <controls:StatCard Title="LOW STOCK" Value="{Binding Overview.LowStockProducts}"
                                   Caption="At or below reorder level" Glyph="▽"
                                   Accent="{StaticResource AmberBrush}" Margin="0,0,12,0" />
                <controls:StatCard Title="EXPIRING SOON" Value="{Binding Overview.ExpiringSoonBatches}"
                                   Caption="Batches within 30 days" Glyph="◷"
                                   Accent="{StaticResource WarningBrush}" Margin="0,0,12,0" />
                <controls:StatCard Title="EXPIRED BATCHES" Value="{Binding Overview.ExpiredBatches}"
                                   Caption="Awaiting write-off" Glyph="⚠"
                                   Accent="{StaticResource DangerBrush}" />
            </UniformGrid>

            <!-- Valuation -->
            <UniformGrid Columns="4" Margin="0,12,0,0">
                <controls:StatCard Title="PHYSICAL VALUE (LKR)"
                                   Value="{Binding Overview.PhysicalStockValue, StringFormat=N0}"
                                   Caption="All batches at cost" Glyph="◫"
                                   Accent="{StaticResource PrimaryBrush}" Margin="0,0,12,0" />
                <controls:StatCard Title="SELLABLE VALUE (LKR)"
                                   Value="{Binding Overview.SellableStockValue, StringFormat=N0}"
                                   Caption="Excludes expired stock" Glyph="◰"
                                   Accent="{StaticResource SuccessBrush}" Margin="0,0,12,0" />
                <controls:StatCard Title="PHYSICAL QTY"
                                   Value="{Binding Overview.TotalPhysicalStock, StringFormat=N3}"
                                   Caption="All batches" Glyph="≡"
                                   Accent="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                <controls:StatCard Title="SELLABLE QTY"
                                   Value="{Binding Overview.TotalSellableStock, StringFormat=N3}"
                                   Caption="Excludes expired stock" Glyph="≡"
                                   Accent="{StaticResource SuccessBrush}" />
            </UniformGrid>

            <!-- Category breakdowns -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AppCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="STOCK BY CATEGORY" Style="{StaticResource LabelText}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Overview.StockByCategory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CategoryName}" FontSize="12.5" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat=N3}"
                                                   FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat=N2}"
                                                   FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource AppCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="TOP STOCKED" Style="{StaticResource LabelText}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Overview.TopStocked}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                            <TextBlock Text="{Binding Sku}" FontSize="10.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat=N3}"
                                                   FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Alerts -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AppCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="LOW STOCK ALERTS" Style="{StaticResource LabelText}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Overview.LowStockAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProductName}" FontSize="12.5" />
                                            <TextBlock Text="{Binding Sku}" FontSize="10.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource StatusBadgeWarning}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Detail}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource AppCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="EXPIRY ALERTS" Style="{StaticResource LabelText}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Overview.ExpiryAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProductName}" FontSize="12.5" />
                                            <TextBlock Text="{Binding Sku}" FontSize="10.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource StatusBadgeDanger}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Detail}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Margin="2,14,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>