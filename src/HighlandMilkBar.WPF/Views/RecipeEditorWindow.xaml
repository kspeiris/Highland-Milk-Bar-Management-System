<Window x:Class="HighlandMilkBar.WPF.Views.RecipeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recipe editor" Width="820" Height="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Recipe details" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />

        <Border Grid.Row="1" Style="{StaticResource AppCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Recipe name" Style="{StaticResource LabelText}" />
                <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource InputTextBox}" Margin="0,4,10,10"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="0" Grid.Column="1" Text="Menu product" Style="{StaticResource LabelText}" />
                <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource AppComboBox}" Margin="0,4,10,10"
                          ItemsSource="{Binding MenuProducts}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedMenu}" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Yield" Style="{StaticResource LabelText}" />
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,4,0,10">
                    <TextBox Width="70" Style="{StaticResource InputTextBox}" Text="{Binding YieldText, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Width="110" Margin="8,0,0,0" Style="{StaticResource AppComboBox}"
                              ItemsSource="{Binding YieldUnits}" SelectedItem="{Binding YieldUnit}" />
                </StackPanel>

                <CheckBox Grid.Row="2" Grid.Column="0" Content="Active (available for POS sales)" IsChecked="{Binding IsActive}" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Ingredients" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="0,0,14,0" />
                <ComboBox Width="240" Style="{StaticResource AppComboBox}" Margin="0,0,8,0"
                          ItemsSource="{Binding Ingredients}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedIngredient}" ToolTip="Select an ingredient" />
                <Button Content="Add ingredient" Style="{StaticResource PrimaryButton}" MinWidth="130"
                        Command="{Binding AddIngredientCommand}" />
            </StackPanel>

            <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Lines}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="INGREDIENT" Binding="{Binding IngredientName}" Width="2*" IsReadOnly="True" />
                    <DataGridTextColumn Header="QTY" Binding="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                    <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="UNIT COST" Binding="{Binding UnitCost, StringFormat={}{0:N4}}" Width="100" IsReadOnly="True" />
                    <DataGridTextColumn Header="LINE COST" Binding="{Binding LineCost, StringFormat={}{0:N2}}" Width="100" IsReadOnly="True" />
                    <DataGridTextColumn Header="AVAILABILITY" Binding="{Binding AvailabilityText}" Width="140" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" Style="{StaticResource IconButton}"
                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" ToolTip="Remove ingredient" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Row="3" Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding LineCount, StringFormat={}{0} ingredient lines}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="Cost per serving" Style="{StaticResource LabelText}" Margin="0,0,10,0" />
                <TextBlock Grid.Column="2" Text="{Binding CostPerServing, StringFormat=LKR {0:N2}}" FontWeight="Bold" FontSize="16" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" MinWidth="100" Margin="0,0,10,0" IsCancel="True" />
                <Button x:Name="SaveButton" Content="Save recipe" Style="{StaticResource PrimaryButton}" MinWidth="140" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>