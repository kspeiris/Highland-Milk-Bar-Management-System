<UserControl x:Class="HighlandMilkBar.WPF.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls"
             Loaded="SalesHistoryView_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource FlatCard}" Padding="14">
            <StackPanel Orientation="Horizontal">
                <Border Width="220" Margin="0,0,10,0">
                    <controls:SearchBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
                <ComboBox Style="{StaticResource AppComboBox}" MinWidth="140" Margin="0,0,10,0"
                          ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedStatus}" ToolTip="Filter by status" />
                <ComboBox Style="{StaticResource AppComboBox}" MinWidth="150" Margin="0,0,10,0"
                          ItemsSource="{Binding PaymentOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedPayment}" ToolTip="Filter by payment method" />
                <DatePicker MinWidth="130" Margin="0,0,10,0" SelectedDate="{Binding FromDate}" ToolTip="From date" />
                <DatePicker MinWidth="130" Margin="0,0,10,0" SelectedDate="{Binding ToDate}" ToolTip="To date" />
                <Button Content="Search" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="0,0,8,0"
                        Command="{Binding SearchCommand}" />
                <Button Content="Clear" Style="{StaticResource OutlineButton}" MinWidth="80"
                        Command="{Binding ClearCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="‹" Style="{StaticResource IconButton}" Command="{Binding PreviousCommand}" ToolTip="Previous page" />
                <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="8,0" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Button Content="›" Style="{StaticResource IconButton}" Command="{Binding NextCommand}" ToolTip="Next page" />
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedSale, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="INVOICE" Binding="{Binding ReceiptNumber}" Width="160" />
                        <DataGridTextColumn Header="DATE" Binding="{Binding SoldAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150" />
                        <DataGridTextColumn Header="ITEMS" Binding="{Binding ItemCount, StringFormat={}{0:0.###}}" Width="80" />
                        <DataGridTextColumn Header="PAYMENT" Binding="{Binding PaymentSummary}" Width="140" />
                        <DataGridTextColumn Header="DISCOUNT" Binding="{Binding DiscountAmount, StringFormat={}{0:N2}}" Width="100" />
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="120" />
                        <DataGridTextColumn Header="STATUS" Binding="{Binding StatusText}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Details" Style="{StaticResource SecondaryButton}" MinWidth="90" Margin="0,0,8,0"
                            Command="{Binding DetailsCommand}" />
                    <Button Content="Reprint receipt" Style="{StaticResource SecondaryButton}" MinWidth="120" Margin="0,0,8,0"
                            Command="{Binding ReprintCommand}" />
                    <Button Content="Process return" Style="{StaticResource OutlineButton}" MinWidth="120"
                            Command="{Binding ReturnCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>