<Window x:Class="HighlandMilkBar.WPF.Views.SaleDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sale details" Width="720" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource FlatCard}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="INVOICE" Style="{StaticResource LabelText}" />
                    <TextBlock x:Name="InvoiceText" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="DateText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="CustomerText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="STATUS" Style="{StaticResource LabelText}" />
                    <TextBlock x:Name="StatusText" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="TOTAL" Style="{StaticResource LabelText}" />
                    <TextBlock x:Name="TotalText" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock x:Name="PaidText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Items">
                <DataGrid x:Name="ItemsGrid" Style="{StaticResource AppDataGrid}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCT" Binding="{Binding ItemNameSnapshot}" Width="2*" />
                        <DataGridTextColumn Header="QTY" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="70" />
                        <DataGridTextColumn Header="UNIT PRICE" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="100" />
                        <DataGridTextColumn Header="DISCOUNT" Binding="{Binding DiscountAmount, StringFormat={}{0:N2}}" Width="100" />
                        <DataGridTextColumn Header="LINE TOTAL" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Payments">
                <DataGrid x:Name="PaymentsGrid" Style="{StaticResource AppDataGrid}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="METHOD" Binding="{Binding MethodText}" Width="160" />
                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120" />
                        <DataGridTextColumn Header="REFERENCE" Binding="{Binding Reference}" Width="2*" />
                        <DataGridTextColumn Header="TIME" Binding="{Binding PaidAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Returns">
                <DataGrid x:Name="ReturnsGrid" Style="{StaticResource AppDataGrid}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="RETURN NO." Binding="{Binding ReturnNumber}" Width="160" />
                        <DataGridTextColumn Header="DATE" Binding="{Binding ReturnedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150" />
                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="120" />
                        <DataGridTextColumn Header="RESTOCKED" Binding="{Binding Restocked}" Width="90" />
                        <DataGridTextColumn Header="STATUS" Binding="{Binding StatusText}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>