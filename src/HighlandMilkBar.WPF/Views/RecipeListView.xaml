<UserControl x:Class="HighlandMilkBar.WPF.Views.RecipeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls"
             Loaded="RecipeListView_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource FlatCard}" Padding="14">
            <StackPanel Orientation="Horizontal">
                <Border Width="220" Margin="0,0,10,0">
                    <controls:SearchBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
                <ComboBox Style="{StaticResource AppComboBox}" MinWidth="170" Margin="0,0,10,0"
                          ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedCategory}" ToolTip="Filter by category" />
                <CheckBox Content="Active only" VerticalAlignment="Center" Margin="0,0,10,0"
                          IsChecked="{Binding ActiveOnly}" />
                <Button Content="Search" Style="{StaticResource PrimaryButton}" MinWidth="90"
                        Command="{Binding SearchCommand}" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,14,10,10">
            <TextBlock Text="{Binding ResultCount, StringFormat={}{0} recipes}" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="New recipe" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="0,0,8,0"
                        Command="{Binding CreateCommand}" />
                <Button Content="Edit" Style="{StaticResource SecondaryButton}" MinWidth="80" Margin="0,0,8,0"
                        Command="{Binding EditCommand}" />
                <Button Content="Details" Style="{StaticResource OutlineButton}" MinWidth="90" Margin="0,0,8,0"
                        Command="{Binding DetailsCommand}" />
                <Button Content="Activate / Deactivate" Style="{StaticResource GhostButton}" MinWidth="160"
                        Command="{Binding ToggleActiveCommand}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource AppCard}" Padding="0">
            <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Recipes}"
                      SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="RECIPE" Binding="{Binding Name}" Width="1.6*" />
                    <DataGridTextColumn Header="MENU PRODUCT" Binding="{Binding MenuProductName}" Width="1.4*" />
                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding CategoryName}" Width="120" />
                    <DataGridTextColumn Header="YIELD" Binding="{Binding YieldText}" Width="90" />
                    <DataGridTextColumn Header="ITEMS" Binding="{Binding ItemCount}" Width="60" />
                    <DataGridTextColumn Header="EST. COST" Binding="{Binding EstimatedCostPerServing, StringFormat={}{0:N2}}" Width="100" />
                    <DataGridTextColumn Header="PRICE" Binding="{Binding SellingPrice, StringFormat=LKR {0:N2}}" Width="100" />
                    <DataGridTextColumn Header="MARGIN" Binding="{Binding EstimatedMarginPercent, StringFormat={}{0:N1}%}" Width="90" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding StatusText}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>