<UserControl x:Class="HighlandMilkBar.WPF.Views.ReportCentreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Reports &amp; Export"
                             Subtitle="Generate, preview, print and export business reports." />

        <Border Grid.Row="1" Style="{StaticResource FlatCard}" Margin="0,14,0,0" Padding="14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Report" VerticalAlignment="Center" Width="60" Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox Style="{StaticResource AppComboBox}" MinWidth="260" Margin="0,0,14,0"
                              ItemsSource="{Binding Reports}" DisplayMemberPath="Title"
                              SelectedItem="{Binding SelectedReport}" ToolTip="Select a report" />
                    <TextBlock Text="Period" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox Style="{StaticResource AppComboBox}" MinWidth="120" Margin="0,0,14,0"
                              ItemsSource="{Binding PeriodOptions}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedPreset}" />
                    <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Style="{StaticResource InputTextBox}" Width="100" Margin="0,0,8,0" Text="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}" ToolTip="yyyy-MM-dd" />
                    <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Style="{StaticResource InputTextBox}" Width="100" Margin="0,0,14,0" Text="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}" ToolTip="yyyy-MM-dd" />
                    <Button Content="Generate" Style="{StaticResource PrimaryButton}" MinWidth="110" Command="{Binding GenerateCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="8" Background="{StaticResource DangerBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Error}" Foreground="White" TextWrapping="Wrap" FontSize="12" />
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="14"
                Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Summary}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="9" Padding="12,8" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource AppCard}" Margin="0,12,0,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Preview}"
                          AutoGenerateColumns="True" IsReadOnly="True" />
                <TextBlock Grid.Row="1" Text="{Binding RowCountText}" FontSize="11.5" Margin="12,8"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Export PDF" Style="{StaticResource SecondaryButton}" MinWidth="110" Margin="0,0,8,0" Command="{Binding ExportPdfCommand}" />
            <Button Content="Export Excel" Style="{StaticResource SecondaryButton}" MinWidth="110" Margin="0,0,8,0" Command="{Binding ExportExcelCommand}" />
            <Button Content="Export CSV" Style="{StaticResource OutlineButton}" MinWidth="100" Margin="0,0,8,0" Command="{Binding ExportCsvCommand}" />
            <Button Content="Print" Style="{StaticResource OutlineButton}" MinWidth="90" Command="{Binding PrintCommand}" />
        </StackPanel>
    </Grid>
</UserControl>