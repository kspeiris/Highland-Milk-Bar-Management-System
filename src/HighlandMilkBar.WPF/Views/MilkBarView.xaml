<UserControl x:Class="HighlandMilkBar.WPF.Views.MilkBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls"
             xmlns:vm="clr-namespace:HighlandMilkBar.WPF.ViewModels"
             xmlns:views="clr-namespace:HighlandMilkBar.WPF.Views"
             Loaded="MilkBarView_Loaded">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:MilkBarOverviewViewModel}">
            <views:MilkBarOverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MenuViewModel}">
            <views:MenuView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecipeListViewModel}">
            <views:RecipeListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IngredientListViewModel}">
            <views:IngredientListView />
        </DataTemplate>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9"
                                Padding="16,9" Margin="0,0,6,0">
                            <TextBlock x:Name="Lbl" Text="{TemplateBinding Header}" FontSize="13"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Milk Bar"
                             Subtitle="Menu items, recipes, ingredient usage, costing and pricing.">
            <controls:PageHeader.HeaderContent>
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}" MinWidth="110"
                        Command="{Binding RefreshCommand}" />
            </controls:PageHeader.HeaderContent>
        </controls:PageHeader>

        <TabControl Grid.Row="1" Margin="0,14,0,0">
            <TabItem Header="Overview">
                <ContentControl Content="{Binding Overview}" />
            </TabItem>
            <TabItem Header="Menu">
                <ContentControl Content="{Binding Menu}" />
            </TabItem>
            <TabItem Header="Recipes">
                <ContentControl Content="{Binding Recipes}" />
            </TabItem>
            <TabItem Header="Ingredients">
                <ContentControl Content="{Binding Ingredients}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>