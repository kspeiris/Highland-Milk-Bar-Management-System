<Window x:Class="HighlandMilkBar.WPF.Views.CategoryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Category" Width="480" Height="440" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeaderTitle" Text="New category" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Categories group the products sold at your outlet."
                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="CATEGORY NAME *" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
            <TextBox x:Name="NameInput" Style="{StaticResource InputTextBox}" Margin="0,0,0,14" />

            <TextBlock Text="DESCRIPTION" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
            <TextBox x:Name="DescriptionInput" Style="{StaticResource InputTextBox}" Height="90"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" MinWidth="90" Margin="0,0,9,0" IsCancel="True" />
            <Button Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="120" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>