<Window x:Class="HighlandMilkBar.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HighlandMilkBar.WPF.ViewModels"
        xmlns:views="clr-namespace:HighlandMilkBar.WPF.Views"
        xmlns:controls="clr-namespace:HighlandMilkBar.WPF.Controls"
        Title="Highland Milk Bar | Management System"
        Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesHistoryViewModel}">
            <views:SalesHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MilkBarViewModel}">
            <views:MilkBarView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchasesViewModel}">
            <views:PurchasesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
            <views:SuppliersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0" Width="{Binding SidebarWidth}" Background="{StaticResource SidebarBrush}">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" Grid.Row="0">
                    <Border Width="42" Height="42" CornerRadius="12"
                            Background="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center">
                        <TextBlock Text="H" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="HIGHLAND" FontSize="16" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="MILK BAR MANAGEMENT" FontSize="8.5"
                                   Foreground="{StaticResource SidebarTextBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <!-- Collapse toggle -->
                <Button Grid.Row="1" Style="{StaticResource IconButton}" Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding ToggleSidebarCommand}"
                        Content="{Binding SidebarGlyph}"
                        ToolTip="Collapse or expand the sidebar" />

                <!-- Navigation -->
                <ScrollViewer Grid.Row="2" Margin="0,8,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarNavButton}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="17"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource InverseBoolToVis}}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="3" Background="#163B55" CornerRadius="12" Padding="12" Margin="0,14,0,0"
                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="  LOCAL MODE" FontSize="10" FontWeight="Bold"
                                       Foreground="#E7F2F8" />
                        </StackPanel>
                        <TextBlock Text="Your data is stored on this computer." TextWrapping="Wrap"
                                   FontSize="10.5" Foreground="{StaticResource SidebarTextBrush}" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== Main area ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="84" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0,28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="{Binding CurrentTitle}" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentSubtitle}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="260" Margin="0,0,14,0">
                            <controls:SearchBox Text="{Binding SearchText, Mode=TwoWay}" />
                        </Border>
                        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="9"
                                Padding="12,8" Margin="0,0,14,0">
                            <TextBlock Text="{Binding TodayLabel}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,8,0"
                                Background="{StaticResource PrimaryLightBrush}"
                                ToolTip="Notifications">
                            <TextBlock Text="!" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button Style="{StaticResource IconButton}" Content="⚙"
                                ToolTip="Settings" Command="{Binding OpenSettingsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"
                            Margin="{StaticResource PageMargin}" />
        </Grid>
    </Grid>
</Window>