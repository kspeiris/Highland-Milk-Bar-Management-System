<Window x:Class="HighlandMilkBar.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HighlandMilkBar.WPF.ViewModels"
        xmlns:views="clr-namespace:HighlandMilkBar.WPF.Views"
        Title="Highland Milk Bar | Management System"
        Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}"><views:ProductsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><views:PlaceholderView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Grid.Column="0" Background="#102F46">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="2,0,0,0">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#E8F3FC" VerticalAlignment="Center">
                        <TextBlock Text="H" FontSize="25" FontWeight="Bold" Foreground="#145D96" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HIGHLAND" FontSize="16" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="MILK BAR MANAGEMENT" FontSize="8.5" Foreground="#A9BDCE" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="#7894AA" Margin="8,0,0,8" />

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarNavButton}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="29" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="4" Background="#163B55" CornerRadius="12" Padding="12" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#4ADE80" VerticalAlignment="Center" />
                            <TextBlock Text="  LOCAL MODE" FontSize="10" FontWeight="Bold" Foreground="#E7F2F8" />
                        </StackPanel>
                        <TextBlock Text="Your data is stored on this computer." TextWrapping="Wrap" FontSize="10.5" Foreground="#A9BDCE" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main workspace -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="84" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E7EDF4" BorderThickness="0,0,0,1">
                <Grid Margin="30,0,32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTitle}" FontSize="21" FontWeight="Bold" />
                        <TextBlock Text="{Binding CurrentSubtitle}" FontSize="11.5" Foreground="#77869A" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F4F7FB" CornerRadius="9" Padding="12,9" Margin="0,0,14,0">
                            <TextBlock Text="{Binding TodayLabel}" FontSize="11.5" Foreground="#52647A" />
                        </Border>
                        <Border Width="38" Height="38" CornerRadius="19" Background="#E7F1FA">
                            <TextBlock Text="O" FontSize="14" FontWeight="Bold" Foreground="#145D96" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="28,22,28,26" />
        </Grid>
    </Grid>
</Window>
