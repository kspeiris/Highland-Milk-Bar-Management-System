<UserControl x:Class="HighlandMilkBar.WPF.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="64" Height="64" CornerRadius="18"
                Background="{StaticResource PrimaryLightBrush}"
                HorizontalAlignment="Center">
            <TextBlock Text="{Binding Glyph, ElementName=Root}"
                       FontSize="28"
                       Foreground="{StaticResource PrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding Title, ElementName=Root}"
                   Style="{StaticResource CardHeadingText}"
                   HorizontalAlignment="Center"
                   Margin="0,16,0,4" />
        <TextBlock Text="{Binding Message, ElementName=Root}"
                   Style="{StaticResource SecondaryText}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="460"
                   HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>