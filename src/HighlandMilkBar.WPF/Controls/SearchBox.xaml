<UserControl x:Class="HighlandMilkBar.WPF.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlRadius}"
            Height="40">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="⌕" FontSize="18"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBox x:Name="Input" Grid.Column="1"
                     Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent" BorderThickness="0"
                     VerticalContentAlignment="Center"
                     Padding="4,0,12,0" FontSize="13" />
        </Grid>
    </Border>
</UserControl>