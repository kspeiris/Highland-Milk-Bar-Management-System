<UserControl x:Class="HighlandMilkBar.WPF.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{Binding Subtitle, ElementName=Root}" Style="{StaticResource SecondaryText}"
                       Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <ContentPresenter Grid.Column="1" Content="{Binding HeaderContent, ElementName=Root}"
                          VerticalAlignment="Center" />
    </Grid>
</UserControl>