<UserControl x:Class="HighlandMilkBar.WPF.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{Binding BadgeBackground, ElementName=Root}"
            CornerRadius="{StaticResource PillRadius}"
            Padding="10,4"
            VerticalAlignment="Center"
            HorizontalAlignment="Left">
        <TextBlock Text="{Binding Text, ElementName=Root}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{Binding BadgeForeground, ElementName=Root}" />
    </Border>
</UserControl>