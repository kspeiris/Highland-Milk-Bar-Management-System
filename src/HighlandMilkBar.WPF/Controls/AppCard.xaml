<UserControl x:Class="HighlandMilkBar.WPF.Controls.AppCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource AppCard}">
        <StackPanel>
            <TextBlock Text="{Binding Header, ElementName=Root}"
                       Style="{StaticResource CardHeadingText}"
                       Margin="0,0,0,12" />
            <ContentPresenter Content="{Binding Body, ElementName=Root}" />
        </StackPanel>
    </Border>
</UserControl>