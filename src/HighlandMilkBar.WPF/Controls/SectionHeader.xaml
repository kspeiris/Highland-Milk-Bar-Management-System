<UserControl x:Class="HighlandMilkBar.WPF.Controls.SectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel>
        <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource SectionHeadingText}" />
        <TextBlock Text="{Binding Subtitle, ElementName=Root}" Style="{StaticResource SecondaryText}"
                   Margin="0,4,0,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>