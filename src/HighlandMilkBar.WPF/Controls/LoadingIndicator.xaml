<UserControl x:Class="HighlandMilkBar.WPF.Controls.LoadingIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <ProgressBar IsIndeterminate="True" Height="4"
                 Foreground="{StaticResource PrimaryBrush}"
                 Background="{StaticResource PrimaryLightBrush}"
                 BorderThickness="0"
                 Visibility="{Binding IsLoading, ElementName=Root, Converter={StaticResource BoolToVis}}" />
</UserControl>